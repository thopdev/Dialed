{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/Dialed.slnx"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test",
        "--solution",
        "${workspaceFolder}/Dialed.slnx"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "run: Aspire",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/Dialed.AppHost",
        "--launch-profile",
        "https"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "run: Aspire + dev tunnel",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/src/Dialed.AppHost",
        "--launch-profile",
        "tunnel"
      ],
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "git: fetch",
      "type": "process",
      "command": "git",
      "args": [
        "fetch",
        "--prune",
        "origin"
      ],
      "problemMatcher": []
    },
    {
      "label": "cosmos: start emulator (8081)",
      "type": "shell",
      "command": "docker start cosmos-spike; if (-not $?) { docker run -d --name cosmos-spike -p 8081:8081 mcr.microsoft.com/cosmosdb/linux/azure-cosmos-emulator:vnext-latest }",
      "problemMatcher": [],
      "windows": {
        "options": {
          "shell": {
            "executable": "powershell.exe",
            "args": [
              "-NoProfile",
              "-Command"
            ]
          }
        }
      }
    },
    {
      "label": "spike: passkeys",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "${workspaceFolder}/spikes/PasskeySpike",
        "--launch-profile",
        "https"
      ],
      "dependsOn": [
        "cosmos: start emulator (8081)"
      ],
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet-run",
        "pattern": {
          "regexp": "^__never__$"
        },
        "background": {
          "activeBegins": true,
          "beginsPattern": "^.*Building",
          "endsPattern": "Now listening on|Application started"
        }
      }
    },
    {
      "label": "devtunnel: 7300",
      "type": "shell",
      "detail": "Named tunnel 'dialed-passkeys' that keeps the browser's Origin header (passkeys need it).",
      "command": "devtunnel create dialed-passkeys --allow-anonymous 2>$null; devtunnel port create dialed-passkeys -p 7300 --protocol https 2>$null; devtunnel update dialed-passkeys --origin-header unchanged; devtunnel host dialed-passkeys",
      "isBackground": true,
      "problemMatcher": {
        "owner": "devtunnel",
        "pattern": {
          "regexp": "^__never__$"
        },
        "background": {
          "activeBegins": true,
          "beginsPattern": "^.",
          "endsPattern": "Ready to accept connections"
        }
      },
      "windows": {
        "options": {
          "shell": {
            "executable": "powershell.exe",
            "args": [
              "-NoProfile",
              "-Command"
            ]
          }
        }
      }
    },
    {
      "label": "spike: passkeys + dev tunnel (iPhone)",
      "dependsOn": [
        "spike: passkeys",
        "devtunnel: 7300"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
