@page "/people/{UserId}"
@using System.Text.Json
@using Dialed.Client.Account
@using Dialed.Client.Friends
@inject FriendsApi Friends
@inject FriendCopyService Copying
@inject IStringLocalizer<Strings> L

<PageHeader Title="@(profile?.DisplayName ?? L["Nav_People"].Value)" BackHref="people" />

@if (loading)
{
    <Loading IsLoading="true" />
}
else if (profile is null)
{
    <EmptyState Icon="@(offline ? new Icons.Regular.Size24.CloudOff() : new Icons.Regular.Size24.PersonClock())"
                Title="@(offline ? null : L["People_ProfileUnavailableTitle"].Value)"
                Message="@L[offline ? "People_Offline" : "People_ProfileUnavailable"]">
        @if (!offline)
        {
            <a id="friend-back-people" class="dialed-button" href="people">@L["People_BackToPeople"]</a>
        }
    </EmptyState>
    @if (offline)
    {
        <button id="friend-retry" type="button" class="dialed-button" @onclick="LoadAsync">@L["Error_Retry"]</button>
    }
}
else
{
    @if (offline)
    {
        <p id="friend-offline" class="dialed-muted" role="status">@L["People_ShowingSaved"]</p>
    }

    <header id="friend-header" class="dialed-friend-header">
        <Avatar Name="@profile.DisplayName" Size="64" />
        <div class="dialed-friend-header-text">
            <strong id="friend-name">@profile.DisplayName</strong>
            <span id="friend-counts" class="dialed-muted">@(profile.IsPublicView
                ? string.Join(" · ", L.Count("Beans", profile.Beans), L.Count("Recipes", profile.Recipes))
                : string.Join(" · ", L.Count("Beans", profile.Beans), L.Count("Recipes", profile.Recipes), L.Count("Brews", profile.Brews), L.Count("Followers", profile.Followers)))</span>
        </div>
    </header>

    @if (profile.Relation is "none" or "requested" or "following")
    {
        <div id="friend-actions" class="dialed-form-actions">
            @if (profile.Relation == "none")
            {
                <button id="friend-follow" type="button" class="dialed-button dialed-button-primary" disabled="@busy" @onclick="FollowAsync">@L["People_FollowPublic"]</button>
            }
            else if (profile.Relation == "requested")
            {
                <span id="friend-requested" class="dialed-muted" role="status">@L["People_RequestSent"]</span>
            }

            <ReportForm OwnerId="@UserId" Target="profile" Name="@profile.DisplayName" />
        </div>
        @if (followFailed)
        {
            <p id="friend-follow-failed" class="dialed-field-error" role="alert">@L["People_FollowFailed"]</p>
        }
    }

    <div role="tablist" class="dialed-segmented" aria-label="@L["People_SharedLabel"]">
        @foreach (var tab in Tabs.Where(t => !(profile.IsPublicView && t == "brews")))
        {
            <button type="button" role="tab" id="friend-tab-@tab" class="dialed-segment @(tab == current ? "selected" : "")" aria-selected="@(tab == current)" @onclick="() => SelectAsync(tab)">@L[$"People_Tab_{tab}"]</button>
        }
    </div>

    @if (page is null)
    {
        <Loading IsLoading="true" />
    }
    else if (items.Count == 0)
    {
        <EmptyState Icon="@(new Icons.Regular.Size24.Box())" Message="@L["People_NothingShared"]" />
    }
    else
    {
        @if (message is not null)
        {
            <p id="friend-copy-message" class="dialed-banner dialed-banner-info" role="status">
                @message
                @if (messageHref is not null)
                {
                    <a class="dialed-section-link" href="@messageHref">@L["People_CopyOpen"]</a>
                }
            </p>
        }
        <ul id="friend-items" class="dialed-list dialed-friend-items">
            @foreach (var item in items)
            {
                var id = IdOf(item);
                <li class="friend-row">
                    <span class="friend-item">@Title(item)</span>
                    @if (Copyable)
                    {
                        @if (copies.TryGetValue(id, out var copy))
                        {
                            <a class="friend-copied dialed-chip dialed-chip-small dialed-chip-positive" href="@($"{current}/{copy.Id}")">@L["People_InYourHousehold"]</a>
                        }
                        else
                        {
                            <button type="button" class="dialed-button friend-copy" disabled="@(busy || copying == id)" aria-label="@string.Format(L["People_CopyNamed"].Value, Title(item))" @onclick="() => CopyAsync(item)">@L["People_Copy"]</button>
                        }
                        @if (profile.Relation is "none" or "requested" or "following")
                        {
                            <ReportForm OwnerId="@UserId" Target="@(current == "beans" ? "bean" : "recipe")" ItemId="@id" Name="@Title(item)" />
                        }
                    }
                </li>
            }
        </ul>
        @if (page.HasMore)
        {
            <button id="friend-more" type="button" class="dialed-button" disabled="@busy" @onclick="MoreAsync">@L["People_LoadMore"]</button>
        }
    }
}

@code {
    private static readonly string[] Tabs = ["beans", "recipes", "brews"];

    [Parameter]
    public string UserId { get; set; } = "";

    private FriendProfileInfo? profile;
    private SharedPage? page;
    private readonly List<JsonElement> items = [];
    private string current = "beans";
    private bool loading = true;
    private bool offline;
    private bool busy;
    private string? message;
    private string? messageHref;
    private string? copying;
    private bool followFailed;
    private readonly Dictionary<string, CopyResult> copies = [];

    /// <summary>Beans and recipes can be copied to my household; brews cannot.</summary>
    private bool Copyable => current is "beans" or "recipes";

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        offline = false;
        try
        {
            profile = await Friends.ProfileAsync(UserId);
        }
        catch (Exception e) when (e is AccountApiException or AccountRefusedException)
        {
            // No network: show what was seen last time, if anything.
            offline = true;
            profile = Friends.CachedProfile(UserId);
        }

        loading = false;
        if (profile is not null)
        {
            await SelectAsync(current);
        }
    }

    private async Task SelectAsync(string tab)
    {
        current = tab;
        page = null;
        items.Clear();
        try
        {
            page = await Friends.SharedAsync(UserId, tab, 0) ?? new SharedPage([], 0, false);
        }
        catch (Exception e) when (e is AccountApiException or AccountRefusedException)
        {
            offline = true;
            page = Friends.CachedFirstPage(UserId, tab) ?? new SharedPage([], 0, false);
        }

        items.AddRange(page.Items);
        message = null;
        await MarkCopiesAsync(page.Items);
    }

    /// <summary>Items I already copied show "In your household" instead of a Copy button (no network needed).</summary>
    private async Task MarkCopiesAsync(IEnumerable<JsonElement> shown)
    {
        if (!Copyable)
        {
            return;
        }

        foreach (var item in shown)
        {
            if (await Copying.ExistingAsync(UserId, current, IdOf(item)) is { } existing)
            {
                copies[IdOf(item)] = existing;
            }
        }
    }

    private async Task CopyAsync(JsonElement item)
    {
        var id = IdOf(item);
        copying = id;
        message = null;
        messageHref = null;
        try
        {
            var result = await Copying.CopyAsync(UserId, current, id);
            switch (result.Outcome)
            {
                case CopyOutcome.Copied or CopyOutcome.AlreadyCopied:
                    copies[id] = result;
                    message = string.Format(L[result.Outcome == CopyOutcome.Copied ? "People_Copied" : "People_AlreadyCopied"].Value, result.Name);
                    messageHref = $"{current}/{result.Id}";
                    break;
                default:
                    message = L["People_CopyUnavailable"];
                    break;
            }
        }
        catch (Exception e) when (e is AccountApiException or AccountRefusedException)
        {
            message = L["People_CopyOffline"];
        }

        copying = null;
    }

    private async Task FollowAsync()
    {
        busy = true;
        followFailed = false;
        try
        {
            await Friends.FollowPublicAsync(UserId);
            profile = profile! with { Relation = "requested" };
        }
        catch (Exception e) when (e is AccountApiException or AccountRefusedException)
        {
            followFailed = true;
        }

        busy = false;
    }

    private async Task MoreAsync()
    {
        busy = true;
        try
        {
            if (await Friends.SharedAsync(UserId, current, items.Count) is { } next)
            {
                items.AddRange(next.Items);
                page = next;
                await MarkCopiesAsync(next.Items);
            }
        }
        catch (Exception e) when (e is AccountApiException or AccountRefusedException)
        {
            offline = true;
        }

        busy = false;
    }


    private static string IdOf(JsonElement item) => item.TryGetProperty("id", out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() ?? "" : "";

    private static string Title(JsonElement item)
    {
        static string? Text(JsonElement e, string name) => e.TryGetProperty(name, out var v) && v.ValueKind == JsonValueKind.String ? v.GetString() : null;

        return Text(item, "name") ?? Text(item, "methodCode") ?? Text(item, "id") ?? "";
    }
}
