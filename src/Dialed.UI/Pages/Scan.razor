@page "/scan"
@using Dialed.Client
@using Dialed.Client.Account
@using Dialed.Client.Data
@using Dialed.Client.Platform
@using Dialed.Client.Scan
@using Dialed.Domain.Import
@using Dialed.Domain.Model
@using Dialed.Domain.Text
@inject IStringLocalizer<Strings> L
@inject IPhotoCapture Capture
@inject ILabelScanner Scanner
@inject IScanQueue Queue
@implements IDisposable
@inject PhotoService Photos
@inject AuthSession Session
@inject IRepository<Bean> BeanStore
@inject IRepository<Bag> BagStore
@inject IRepository<Vendor> VendorStore
@inject NavigationManager Navigation
@inject Dialed.Client.Catalog.ICatalogApi Catalog

<PageHeader Title="@L["Scan_Title"]" BackHref="beans" />

@if (!Session.IsSignedIn)
{
    <EmptyState Message="@L["Scan_SignedOut"]">
        <a id="scan-signin" class="dialed-button" href="signin">@L["SignIn_Title"]</a>
        <a class="dialed-button" href="beans/new">@L["Beans_New"]</a>
    </EmptyState>
}
else if (label is null)
{
    <p class="dialed-muted" id="scan-hint">@L["Scan_Hint"]</p>
    @if (queuedNote)
    {
        <p id="scan-queued" role="status">@L["Scan_Queued"]</p>
    }
    @if (problem is not null)
    {
        <p id="scan-problem" role="alert">@L[$"Scan_Problem_{problem}"]</p>
        @if (offlineCapture is not null)
        {
            <p><button id="scan-later" type="button" class="dialed-button dialed-button-primary" disabled="@busy" @onclick="ScanLaterAsync">@L["Scan_Later"]</button></p>
        }
        <p><a href="beans/new">@L["Beans_New"]</a></p>
    }

    <div class="dialed-form-actions">
        <button id="scan-camera" type="button" class="dialed-button dialed-button-primary" disabled="@busy" @onclick="() => ScanAsync(PhotoSource.Camera)">@L["Photo_Take"]</button>
        <button id="scan-library" type="button" class="dialed-button" disabled="@busy" @onclick="() => ScanAsync(PhotoSource.Library)">@L["Photo_Choose"]</button>
    </div>
    @if (busy)
    {
        <p id="scan-busy" role="status">@L["Scan_Reading"]</p>
    }

    @if (Queue.Items.Count > 0)
    {
        <section id="scan-pending" class="dialed-scan-pending" aria-labelledby="scan-pending-title">
            <h2 id="scan-pending-title">@L["Scan_PendingTitle"]</h2>
            <ul class="dialed-list">
                @foreach (var item in Queue.Items)
                {
                    <li class="dialed-row scan-pending-row" data-photo="@item.PhotoId" data-status="@item.Status">
                        <Thumb PhotoId="@item.PhotoId" Size="48" />
                        <span class="dialed-row-text">
                            <span class="dialed-row-title">@PendingTitle(item)</span>
                            <span class="dialed-row-subtitle scan-pending-status">@PendingStatus(item)</span>
                        </span>
                        <span class="scan-pending-actions">
                            @if (item.Status == PendingScanStatus.Ready)
                            {
                                <button type="button" class="dialed-button dialed-button-primary scan-pending-review" aria-label="@string.Format(L["Scan_ReviewNamed"].Value, PendingTitle(item))" @onclick="() => ReviewPending(item)">@L["Scan_ReviewOpen"]</button>
                            }
                            else if (item.Status == PendingScanStatus.Failed)
                            {
                                <button type="button" class="dialed-button scan-pending-retry" aria-label="@string.Format(L["Scan_RetryNamed"].Value, PendingTitle(item))" @onclick="() => Queue.RetryAsync(item.PhotoId)">@L["Scan_Retry"]</button>
                            }
                            <button type="button" class="dialed-button scan-pending-discard" aria-label="@string.Format(L["Scan_DiscardNamed"].Value, PendingTitle(item))" @onclick="() => DiscardPendingAsync(item)">@L["Scan_Discard"]</button>
                        </span>
                    </li>
                }
            </ul>
        </section>
    }
}
else
{
    <form id="scan-review" class="dialed-form" @onsubmit="SaveAsync" @onsubmit:preventDefault>
        <p class="dialed-muted">@L["Scan_Review"]</p>

        <div class="@Field(label.Name)">
            <label for="scan-name">@L["Bean_Name"]</label>
            <input id="scan-name" type="text" @bind="name" autocomplete="off" />
            @Uncertain(label.Name)
        </div>

        <div class="@Field(label.Roaster)">
            <label for="scan-roaster">@L["Bean_Roaster"]</label>
            <input id="scan-roaster" type="text" @bind="roaster" @bind:after="Rematch" autocomplete="off" />
            @Uncertain(label.Roaster)
            @if (match?.BestRoaster is { } likelyRoaster)
            {
                <fieldset id="scan-roaster-match">
                    <legend>@L["Scan_RoasterMatch", likelyRoaster.Item.Name]</legend>
                    <label><input type="radio" name="roaster-choice" checked="@(linkRoaster)" @onchange="() => linkRoaster = true" /> @L["Scan_LinkExisting"]</label>
                    <label><input type="radio" name="roaster-choice" checked="@(!linkRoaster)" @onchange="() => linkRoaster = false" /> @L["Scan_CreateNew"]</label>
                </fieldset>
            }
        </div>

        @if (match?.BestBean is { } likelyBean)
        {
            <fieldset id="scan-bean-match">
                <legend>@L["Scan_BeanMatch", likelyBean.Item.Name]</legend>
                <label><input type="radio" name="bean-choice" checked="@(linkBean)" @onchange="() => linkBean = true" /> @L["Scan_UseExistingBean"]</label>
                <label><input type="radio" name="bean-choice" checked="@(!linkBean)" @onchange="() => linkBean = false" /> @L["Scan_CreateNew"]</label>
            </fieldset>
        }

        @if (match?.BestBean is null && catalogCandidates.Count > 0)
        {
            <section id="scan-catalog" class="dialed-catalog" aria-labelledby="scan-catalog-title">
                <h3 id="scan-catalog-title">@L["Scan_CatalogTitle"]</h3>
                <p class="dialed-muted">@L["Catalog_Hint"]</p>
                <ul class="dialed-list">
                    @foreach (var entry in catalogCandidates)
                    {
                        <li class="catalog-row" data-catalog="@entry.Id">
                            <span class="catalog-text">
                                <strong class="catalog-name">@entry.Name</strong>
                                <span class="dialed-muted catalog-detail">@string.Join(" · ", new[] { entry.RoasterName, entry.Country, entry.Process }.Where(part => !string.IsNullOrWhiteSpace(part)))</span>
                            </span>
                            <button type="button" class="dialed-button catalog-use" aria-label="@string.Format(L["Catalog_UseNamed"].Value, entry.Name)" @onclick="() => UseCatalog(entry)">@L["Catalog_Use"]</button>
                        </li>
                    }
                </ul>
            </section>
        }

        <div class="@Field(label.Country)">
            <label for="scan-country">@L["Bean_Country"]</label>
            <input id="scan-country" type="text" @bind="country" autocomplete="off" />
            @Uncertain(label.Country)
        </div>
        <div class="@Field(label.Region)">
            <label for="scan-region">@L["Bean_Region"]</label>
            <input id="scan-region" type="text" @bind="region" autocomplete="off" />
            @Uncertain(label.Region)
        </div>
        <div class="@Field(label.Process)">
            <label for="scan-process">@L["Bean_Process"]</label>
            <input id="scan-process" type="text" @bind="process" autocomplete="off" />
            @Uncertain(label.Process)
        </div>
        <div class="@Field(label.Varieties)">
            <label for="scan-varieties">@L["Bean_Varieties"]</label>
            <input id="scan-varieties" type="text" @bind="varieties" autocomplete="off" />
            @Uncertain(label.Varieties)
        </div>
        <div class="@Field(label.RoastLevel)">
            <label for="scan-roast">@L["Bean_RoastLevel"]</label>
            <input id="scan-roast" type="text" @bind="roastLevel" autocomplete="off" />
            @Uncertain(label.RoastLevel)
        </div>
        <div class="@Field(label.TastingNotes)">
            <label for="scan-notes">@L["Bean_Notes"]</label>
            <input id="scan-notes" type="text" @bind="notes" autocomplete="off" />
            @Uncertain(label.TastingNotes)
        </div>

        <h2>@L["Scan_BagHeading"]</h2>
        <div class="@Field(label.WeightG)">
            <label for="scan-weight">@L["Import_Field_WeightG"] (g)</label>
            <input id="scan-weight" type="text" inputmode="decimal" @bind="weight" autocomplete="off" />
            @Uncertain(label.WeightG)
        </div>
        <div class="@Field(label.RoastDate)">
            <label for="scan-roastdate">@L["Import_Field_RoastDate"]</label>
            <input id="scan-roastdate" type="date" value="@roastDate" @onchange="e => roastDate = e.Value?.ToString() ?? string.Empty" />
            @Uncertain(label.RoastDate)
        </div>

        @if (nameMissing)
        {
            <p id="scan-name-missing" role="alert">@L["Bean_NameRequired"]</p>
        }

        <div class="dialed-form-actions">
            <button id="scan-save" type="submit" class="dialed-button dialed-button-primary" disabled="@busy">@L["Scan_Save"]</button>
            <button id="scan-again" type="button" class="dialed-button" disabled="@busy" @onclick="Reset">@L["Scan_Again"]</button>
        </div>
    </form>
}

@code {
    private ScannedLabel? label;
    private CapturedPhoto? photo;
    private CapturedPhoto? offlineCapture;
    private string? queuedPhotoId;
    private bool queuedNote;

    /// <summary>A barcode scanned first (#104): the bean made or matched here gets it.</summary>
    [SupplyParameterFromQuery(Name = "barcode")]
    public string? Barcode { get; set; }
    private LabelMatch? match;
    private IReadOnlyList<Dialed.Client.Catalog.CatalogBean> catalogCandidates = [];
    private ScanProblem? problem;
    private bool busy;
    private bool nameMissing;
    private bool linkRoaster = true;
    private bool linkBean = true;
    private string name = "", roaster = "", country = "", region = "", process = "", varieties = "", roastLevel = "", notes = "", weight = "", roastDate = "";

    private static string Field(ScannedField field) => field.IsUncertain ? "dialed-field dialed-uncertain" : "dialed-field";

    private RenderFragment Uncertain(ScannedField field) => builder =>
    {
        if (field.IsUncertain)
        {
            builder.OpenElement(0, "p");
            builder.AddAttribute(1, "class", "dialed-muted scan-uncertain");
            builder.AddContent(2, L["Scan_Uncertain"].Value);
            builder.CloseElement();
        }
    };

    protected override void OnInitialized() => Queue.Changed += OnQueueChanged;

    private void OnQueueChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Queue.Changed -= OnQueueChanged;

    private string PendingTitle(PendingScan item) =>
        item.Draft?.Name.Value is { Length: > 0 } name ? name : L["Scan_PendingUnnamed", item.QueuedAt.ToLocalTime().ToString("d MMM HH:mm", System.Globalization.CultureInfo.CurrentCulture)].Value;

    private string PendingStatus(PendingScan item) => item.Status switch
    {
        PendingScanStatus.Failed => L[$"Scan_Problem_{item.Problem ?? ScanProblem.Unavailable}"].Value,
        _ => L[$"Scan_Status_{item.Status}"].Value,
    };

    /// <summary>Offline: keeps the photo like any other (it uploads when there is a network) and lets the queue read the label afterwards.</summary>
    private async Task ScanLaterAsync()
    {
        if (offlineCapture is null)
        {
            return;
        }

        busy = true;
        try
        {
            var saved = await Photos.AddAsync(offlineCapture);
            await Queue.EnqueueAsync(saved.Id);
            offlineCapture = null;
            problem = null;
            queuedNote = true;
        }
        finally
        {
            busy = false;
        }
    }

    /// <summary>Opens the draft the queue kept in the same review form as a fresh scan; the photo is the one already saved.</summary>
    private async Task ReviewPending(PendingScan item)
    {
        if (item.Draft is not { } draft)
        {
            return;
        }

        queuedPhotoId = item.PhotoId;
        photo = null;
        await ShowAsync(draft);
    }

    private async Task DiscardPendingAsync(PendingScan item)
    {
        await Queue.RemoveAsync(item.PhotoId);
        await Photos.RemoveAsync(item.PhotoId);
    }

    private async Task ShowAsync(ScannedLabel scanned)
    {
        label = scanned;
        name = scanned.Name.Value ?? "";
        roaster = scanned.Roaster.Value ?? "";
        country = scanned.Country.Value ?? "";
        region = scanned.Region.Value ?? "";
        process = scanned.Process.Value ?? "";
        varieties = scanned.Varieties.Value ?? "";
        roastLevel = scanned.RoastLevel.Value ?? "";
        notes = scanned.TastingNotes.Value ?? "";
        weight = scanned.WeightG.Value ?? "";
        roastDate = BeanImport.ParseDate(scanned.RoastDate.Value)?.ToString("yyyy-MM-dd") ?? "";
        await Rematch();
    }

    private async Task ScanAsync(PhotoSource source)
    {
        problem = null;
        queuedNote = false;
        offlineCapture = null;
        var captured = await Capture.CaptureAsync(source, 1600);
        if (captured is null)
        {
            return;
        }

        busy = true;
        try
        {
            var scanned = await Scanner.ScanAsync(captured);
            photo = captured;
            queuedPhotoId = null;
            await ShowAsync(scanned);
        }
        catch (LabelScanException exception)
        {
            problem = exception.Problem;

            // Without a network the photo can still be kept and read later; other problems (quota, switched off) would not change by waiting.
            offlineCapture = exception.Problem == ScanProblem.Offline ? captured : null;
        }
        finally
        {
            busy = false;
        }
    }

    private async Task Rematch()
    {
        match = LabelMatcher.Find(roaster, name, country, await VendorStore.ListAsync(), await BeanStore.ListAsync());
        linkRoaster = true;
        linkBean = true;
        await FindCatalogAsync();
    }

    /// <summary>Nothing of my own matches: offer what other people share (#105). Online only, optional, never an error.</summary>
    private async Task FindCatalogAsync()
    {
        catalogCandidates = [];
        if (match?.BestBean is not null || string.IsNullOrWhiteSpace(name))
        {
            return;
        }

        catalogCandidates = [.. (await Catalog.SearchBeansAsync(name, roaster)).Take(3)];
    }

    /// <summary>Copies what the catalog knows into the form. The label stays the truth for the name and the roaster.</summary>
    private void UseCatalog(Dialed.Client.Catalog.CatalogBean entry)
    {
        country = entry.Country ?? country;
        region = entry.Region ?? region;
        process = entry.Process ?? process;
        if (entry.Varieties.Count > 0)
        {
            varieties = string.Join(", ", entry.Varieties);
        }

        roastLevel = entry.RoastLevel?.ToString() ?? roastLevel;
        if (entry.TastingNotes.Count > 0)
        {
            notes = string.Join(", ", entry.TastingNotes);
        }

        catalogCandidates = [];
    }

    private void Reset()
    {
        label = null;
        photo = null;
        queuedPhotoId = null;
        match = null;
        catalogCandidates = [];
        nameMissing = false;
    }

    private async Task SaveAsync()
    {
        nameMissing = string.IsNullOrWhiteSpace(name);
        if (nameMissing)
        {
            return;
        }

        busy = true;
        try
        {
            var existingBean = match?.BestBean is { } b && linkBean ? b.Item.Id : null;
            var existingRoaster = match?.BestRoaster is { } r && linkRoaster ? r.Item.Id : null;
            var photoId = existingBean is not null ? null : queuedPhotoId ?? (photo is not null ? (await Photos.AddAsync(photo)).Id : null);
            var grams = BeanImport.ParseWeightG(weight);
            var saved = await ScanSaver.SaveAsync(
                new ScanReview(name, roaster, existingRoaster, country, region, process, varieties, roastLevel, notes, grams, BeanImport.ParseDate(roastDate), existingBean, photoId, Barcode),
                BeanStore, BagStore, VendorStore);
            if (queuedPhotoId is not null)
            {
                await Queue.RemoveAsync(queuedPhotoId);
                if (photoId is null)
                {
                    await Photos.RemoveAsync(queuedPhotoId); // the bean already has its photo: this one is not needed
                }
            }

            Navigation.NavigateTo($"beans/{saved.Bean.Id}");
        }
        finally
        {
            busy = false;
        }
    }
}
