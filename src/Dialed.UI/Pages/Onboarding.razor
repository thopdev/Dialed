@page "/welcome"
@using Dialed.Client
@using Dialed.Client.Data
@using Dialed.Domain.Model
@inject IStringLocalizer<Strings> L
@inject Dialed.Client.Preferences.IUserPreferences Preferences
@inject IPwaState Pwa
@inject IRepository<EquipmentItem> GearStore
@inject NavigationManager Navigation

<PageHeader Title="@L["Onboarding_Title"]" />

<div class="dialed-onboarding">
    <div class="dialed-onboarding-progress">
        <Meter Label="@L["Onboarding_ProgressLabel"]" Fraction="@((index + 1) / (double)steps.Count)" ValueText="@ProgressText" />
        <p class="dialed-muted" id="onboarding-progress">@ProgressText</p>
    </div>

    <div class="dialed-onboarding-hero" data-step="@steps[index]">
        <span class="dialed-onboarding-icon" aria-hidden="true">
            <FluentIcon Value="@StepIcon" Color="Color.Custom" CustomColor="currentColor" Width="40px" />
        </span>
        <h2 id="onboarding-step-title">@L[$"Onboarding_Step_{steps[index]}"]</h2>
        <p class="dialed-muted" id="onboarding-step-hint">@L[$"Onboarding_StepHint_{steps[index]}"]</p>
    </div>

    <div class="dialed-card dialed-onboarding-card">
        @switch (steps[index])
        {
            case "install":
                <InstallGuide />
                break;
            case "units":
                <UnitsSetting />
                break;
            case "methods":
                <FavouriteMethodsPicker />
                break;
            case "gear":
                <div class="dialed-form">
                    <fieldset class="dialed-field dialed-onboarding-gear">
                        <legend>@L["Onboarding_Grinder"]</legend>
                        <div class="dialed-field-row">
                            <div class="dialed-field">
                                <label for="ob-grinder-brand">@L["Gear_Brand"]</label>
                                <input id="ob-grinder-brand" type="text" autocomplete="off" autocapitalize="words" placeholder="Comandante" @bind="grinderBrand" />
                            </div>
                            <div class="dialed-field">
                                <label for="ob-grinder-model">@L["Gear_Model"]</label>
                                <input id="ob-grinder-model" type="text" autocomplete="off" placeholder="C40" @bind="grinderModel" />
                            </div>
                        </div>
                    </fieldset>
                    <fieldset class="dialed-field dialed-onboarding-gear">
                        <legend>@L["Onboarding_Brewer"]</legend>
                        <div class="dialed-field-row">
                            <div class="dialed-field">
                                <label for="ob-brewer-brand">@L["Gear_Brand"]</label>
                                <input id="ob-brewer-brand" type="text" autocomplete="off" autocapitalize="words" placeholder="Hario" @bind="brewerBrand" />
                            </div>
                            <div class="dialed-field">
                                <label for="ob-brewer-model">@L["Gear_Model"]</label>
                                <input id="ob-brewer-model" type="text" autocomplete="off" placeholder="V60" @bind="brewerModel" />
                            </div>
                        </div>
                    </fieldset>
                </div>
                break;
        }
    </div>

    <div class="dialed-form-actions dialed-onboarding-actions">
        @if (index > 0)
        {
            <button id="onboarding-back" type="button" class="dialed-button" @onclick="Back">@L["Onboarding_Back"]</button>
        }
        <button id="onboarding-next" type="button" class="dialed-button dialed-button-primary" @onclick="NextAsync">
            @(index == steps.Count - 1 ? L["Onboarding_Finish"] : L["Onboarding_Next"])
        </button>
        <button id="onboarding-skip" type="button" class="dialed-button dialed-button-subtle" @onclick="SkipAsync">@L["Onboarding_Skip"]</button>
    </div>
</div>

@code {
    private List<string> steps = [];
    private int index;
    private string grinderBrand = "";
    private string grinderModel = "";
    private string brewerBrand = "";
    private string brewerModel = "";

    protected override void OnInitialized()
    {
        steps = [.. new[] { Pwa.NeedsInstallGuide && !Pwa.IsInstalled ? "install" : null, "units", "methods", "gear" }.OfType<string>()];
    }

    private string ProgressText => string.Format(L["Onboarding_Progress"].Value, index + 1, steps.Count);

    private Icon StepIcon => steps[index] switch
    {
        "install" => new Icons.Regular.Size24.PhoneAdd(),
        "units" => new Icons.Regular.Size24.Scales(),
        "methods" => new Icons.Regular.Size24.DrinkCoffee(),
        _ => new Icons.Regular.Size24.Wrench(),
    };

    private void Back() => index = Math.Max(0, index - 1);

    private async Task NextAsync()
    {
        if (steps[index] == "gear")
        {
            await SaveGearAsync();
            await CompleteAsync();
            return;
        }

        index++;
    }

    private Task SkipAsync() => CompleteAsync();

    private async Task SaveGearAsync()
    {
        if (!string.IsNullOrWhiteSpace(grinderBrand))
        {
            await GearStore.SaveAsync(new EquipmentItem { Kind = EquipmentKind.Grinder, Brand = grinderBrand.Trim(), Model = Clean(grinderModel) });
        }

        if (!string.IsNullOrWhiteSpace(brewerBrand))
        {
            await GearStore.SaveAsync(new EquipmentItem { Kind = EquipmentKind.Brewer, Brand = brewerBrand.Trim(), Model = Clean(brewerModel) });
        }
    }

    private static string? Clean(string value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private async Task CompleteAsync()
    {
        await Preferences.SetProfileAsync(Preferences.Profile with { OnboardingDone = true });
        Navigation.NavigateTo("");
    }
}
