@page "/more"
@using Dialed.Client
@inject IStringLocalizer<Strings> L
@inject IAppEnvironment AppEnvironment

<PageHeader Title="@L["Nav_More"]" />

<div class="dialed-list">
    <ListRow Title="@L["Settings_Title"]" Href="settings" />
    <ListRow Title="@L["More_Vendors"]" Href="vendors" />
    <ListRow Title="@L["History_Title"]" Href="history" />
    <ListRow Title="@L["Stock_Title"]" Href="inventory" />
    <ListRow Title="@L["Import_Title"]" Href="import" />
    <ListRow Title="@L["More_Bags"]" Href="bags" />
    <ListRow Title="@L["Gear_Title"]" Href="equipment" />
    <ListRow Title="@L["Nav_People"]" Href="people" />
</div>

@if (AppEnvironment.IsDevelopment)
{
    <p><a href="dev/gallery">Component gallery</a></p>
}
