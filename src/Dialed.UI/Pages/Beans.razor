@using Dialed.Domain.Statistics
@page "/beans"
@page "/beans/{Id}"
@using Dialed.Client.Data
@using System.Globalization
@using Dialed.Client.Preferences
@using Dialed.Domain.BrewMethods
@using Dialed.Domain.Inventory
@using Dialed.Domain.Model
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject IRepository<Bean> BeanStore
@inject IRepository<Bag> BagStore
@inject IRepository<Vendor> VendorStore
@inject IRepository<Recipe> RecipeStore
@inject IRepository<Brew> BrewStore
@inject IUserPreferences Preferences
@inject TimeProvider Time
@inject UnitFormatter Units
@inject NavigationManager Navigation
@inject Dialed.Client.Platform.IFileExport Files
@inject Dialed.Client.Platform.IImageRenderer Images

<ListDetailLayout HasSelection="@(Id is not null)">
    <List>
        <PageHeader Title="@L["Nav_Beans"]">
            <Actions>
                <a id="beans-scan" class="dialed-button" href="scan">@L["Scan_Title"]</a>
                <a id="beans-scan-code" class="dialed-button" href="scan-code">@L["Barcode_Button"]</a>
                <a class="dialed-button dialed-button-primary" href="beans/new">@L["Beans_New"]</a>
            </Actions>
        </PageHeader>

        @if (beans is null)
        {
            <Loading IsLoading="true" />
        }
        else if (beans.Count == 0)
        {
            <EmptyState Icon="@(new Icons.Regular.Size24.Box())" Message="@L["Beans_Empty"]">
                <a class="dialed-button dialed-button-primary" href="beans/new">@L["Beans_New"]</a>
            </EmptyState>
        }
        else
        {
            <div class="dialed-field dialed-search">
                <label for="bean-search" class="dialed-visually-hidden">@L["Beans_Search"]</label>
                <input id="bean-search" type="search" autocomplete="off" placeholder="@L["Beans_Search"]" enterkeyhint="search" @bind="search" @bind:event="oninput" />
            </div>
            <div class="dialed-filter-bar">
                <button type="button" id="bean-filters-toggle" class="dialed-button dialed-button-icon @(showFilters ? "dialed-button-pressed" : "")"
                        aria-expanded="@(showFilters ? "true" : "false")" aria-controls="bean-filters" @onclick="@(() => showFilters = !showFilters)">
                    <span class="dialed-button-glyph" aria-hidden="true"><FluentIcon Value="@(new Icons.Regular.Size20.Filter())" Color="Color.Custom" CustomColor="currentColor" /></span>
                    @(ActiveFilterCount > 0 ? string.Format(L["Beans_FiltersCount"].Value, ActiveFilterCount) : L["Beans_Filters"].Value)
                </button>
                <ChipGroup Label="@L["Beans_Stock"]">
                    <Chip Selected="@(stockFilter is null)" OnClick="@(() => stockFilter = null)">@L["Beans_All"]</Chip>
                    <Chip Selected="@(stockFilter == true)" OnClick="@(() => stockFilter = true)">@L["Beans_InStock"]</Chip>
                </ChipGroup>
            </div>
            <div class="dialed-filters" id="bean-filters" hidden="@(!showFilters)">
                <div class="dialed-field">
                    <label for="bean-filter-roaster">@L["Bean_Roaster"]</label>
                    <select id="bean-filter-roaster" @bind="roasterFilter">
                        <option value="">@L["Beans_Any"]</option>
                        @foreach (var vendor in roasters)
                        {
                            <option value="@vendor.Id">@vendor.Name</option>
                        }
                    </select>
                </div>
                <div class="dialed-field">
                    <label for="bean-filter-process">@L["Bean_Process"]</label>
                    <select id="bean-filter-process" @bind="processFilter">
                        <option value="">@L["Beans_Any"]</option>
                        @foreach (var process in ProcessOptions)
                        {
                            <option value="@process">@process</option>
                        }
                    </select>
                </div>
                <div class="dialed-field">
                    <label for="bean-filter-country">@L["Bean_Country"]</label>
                    <select id="bean-filter-country" @bind="countryFilter">
                        <option value="">@L["Beans_Any"]</option>
                        @foreach (var (key, name) in BeanQuery.Countries(beans ?? []))
                        {
                            <option value="@key">@name</option>
                        }
                    </select>
                </div>
                <div class="dialed-field">
                    <label for="bean-filter-roast">@L["Bean_RoastLevel"]</label>
                    <select id="bean-filter-roast" @bind="roastFilter">
                        <option value="">@L["Beans_Any"]</option>
                        @foreach (var level in Enum.GetValues<RoastLevel>())
                        {
                            <option value="@level">@L[$"RoastLevel_{level}"]</option>
                        }
                    </select>
                </div>
                <div class="dialed-field">
                    <label for="bean-sort">@L["Beans_Sort"]</label>
                    <select id="bean-sort" @bind="sort">
                        @foreach (var option in Enum.GetValues<BeanSort>())
                        {
                            <option value="@option">@L[$"BeanSort_{option}"]</option>
                        }
                    </select>
                </div>
            </div>

            @if (Visible.Count == 0)
            {
                <EmptyState Icon="@(new Icons.Regular.Size24.Search())" Message="@L["Beans_NoResults"]" />
            }
            else
            {
                <div class="dialed-list">
                    @foreach (var bean in Visible)
                    {
                        <ListRow Title="@bean.Name" Subtitle="@Subtitle(bean)" Href="@($"beans/{bean.Id}")" data-bean="@bean.Id">
                            <Leading><RoastThumb PhotoId="@bean.PhotoIds.FirstOrDefault()" Level="@bean.RoastLevel" /></Leading>
                            <Below>
                                <span class="dialed-row-chips">
                                    @if (bean.RoastLevel is { } level)
                                    {
                                        <span class="dialed-chip dialed-chip-small">@L[$"RoastLevel_{level}"]</span>
                                    }
                                    @if (bean.IsDecaf)
                                    {
                                        <span class="dialed-chip dialed-chip-small">@L["Bean_Decaf"]</span>
                                    }
                                    @if (ActiveBags(bean) is > 0 and var count)
                                    {
                                        <span class="dialed-chip dialed-chip-small dialed-chip-positive">@string.Format(L[count == 1 ? "Beans_BagsInStockOne" : "Beans_BagsInStock"].Value, count)</span>
                                    }
                                </span>
                            </Below>
                            <Trailing>
                                @if (bean.Rating is { } stars)
                                {
                                    <RatingBadge Value="stars" />
                                }
                            </Trailing>
                        </ListRow>
                    }
                </div>
            }
        }
    </List>
    <Detail>
        @if (Id is null)
        {
            <EmptyState Icon="@(new Icons.Regular.Size24.Box())" Message="@L["Beans_SelectPrompt"]" />
        }
        else if (Id == "new")
        {
            <PageHeader Title="@L["Beans_New"]" BackHref="beans" />
            <BeanForm Bean="@NewBeanSeed" OnSubmit="CreateAsync" OnCancel="@(() => Navigation.NavigateTo("beans"))" />
        }
        else if (current is null)
        {
            <PageHeader Title="@L["Nav_Beans"]" BackHref="beans" />
            <EmptyState Message="@L["Beans_NotFound"]" />
        }
        else if (editing)
        {
            <PageHeader Title="@current.Name" BackHref="beans" />
            <BeanForm Bean="current" OnSubmit="UpdateAsync" OnCancel="@(() => editing = false)" />
        }
        else
        {
            <PageHeader Title="@current.Name" BackHref="beans">
                <Actions>
                    <button type="button" id="bean-share-card" class="dialed-icon-button" aria-label="@L["BeanCard_Share"]" title="@L["BeanCard_Share"]" disabled="@sharing" @onclick="ShareCardAsync">
                        <FluentIcon Value="@(new Icons.Regular.Size24.Share())" Color="Color.Custom" CustomColor="currentColor" />
                    </button>
                    <button type="button" id="bean-edit" class="dialed-icon-button" aria-label="@L["Edit"]" title="@L["Edit"]" @onclick="@(() => editing = true)">
                        <FluentIcon Value="@(new Icons.Regular.Size24.Edit())" Color="Color.Custom" CustomColor="currentColor" />
                    </button>
                    <button type="button" id="bean-delete" class="dialed-icon-button" aria-label="@L["Delete"]" title="@L["Delete"]" @onclick="@(() => confirmingDelete = true)">
                        <FluentIcon Value="@(new Icons.Regular.Size24.Delete())" Color="Color.Custom" CustomColor="currentColor" />
                    </button>
                </Actions>
            </PageHeader>

            @if (error is not null)
            {
                <ErrorBanner Message="@error" />
            }

            @if (confirmingDelete)
            {
                <div class="dialed-confirm" role="alertdialog" aria-label="@string.Format(L["Bean_DeleteTitle"].Value, current.Name)">
                    <p><strong>@string.Format(L["Bean_DeleteTitle"].Value, current.Name)</strong></p>
                    <p>
                        @if (currentBags.Count > 0)
                        {
                            @string.Format(L["Bean_DeleteUsed"].Value, currentBags.Count)
                        }
                        else
                        {
                            @L["Bean_DeleteUnused"]
                        }
                    </p>
                    <div class="dialed-form-actions">
                        <button type="button" class="dialed-button dialed-button-danger" @onclick="DeleteAsync">@L["Delete"]</button>
                        <button type="button" class="dialed-button" @onclick="@(() => confirmingDelete = false)">@L["Cancel"]</button>
                    </div>
                </div>
            }

            <div class="dialed-bean-hero" id="bean-hero">
                <RoastThumb PhotoId="@current.PhotoIds.FirstOrDefault()" Level="@current.RoastLevel" Size="96" />
                <div class="dialed-bean-hero-text">
                    @if (RoasterName(current) is { } roaster)
                    {
                        <a class="dialed-bean-roaster" href="@($"vendors/{current.RoasterId}")">@roaster</a>
                    }
                    @if (OriginText(current) is { } origin)
                    {
                        <span class="dialed-bean-origin">@origin</span>
                    }
                    @if (current.Rating is { } stars)
                    {
                        <StarRating Value="stars" ReadOnly="true" />
                    }
                </div>
            </div>

            @if (current.Origin.Country is { } originCountry)
            {
                <OriginMap Id="bean-origin-map" Zoom="true" Origins="@([(originCountry, 1)])" />
            }

            @if (current.CopiedFrom is { } copiedFrom)
            {
                <p id="bean-copied-from" class="dialed-muted dialed-copied-from">@string.Format(L["Item_CopiedFrom"].Value, copiedFrom.OwnerName)</p>
            }

            @if (KeyFacts(current) is { Count: > 0 } facts)
            {
                <div class="dialed-stat-grid" id="bean-facts">
                    @foreach (var (label, value) in facts)
                    {
                        <StatTile Value="@value" Label="@label" />
                    }
                </div>
            }

            @if (current.Barcodes.Count > 0)
            {
                <p id="bean-barcodes-list" class="dialed-bean-line dialed-muted">@L["Bean_Barcodes"]: @string.Join(", ", current.Barcodes)</p>
            }

            @if (current.TastingNotes.Count > 0 || current.IsDecaf)
            {
                <SectionHeader Title="@L["Bean_TastingNotes"]" />
                <ul class="dialed-chip-list" id="bean-notes">
                    @foreach (var note in current.TastingNotes)
                    {
                        <li><span class="dialed-chip">@note</span></li>
                    }
                    @if (current.IsDecaf)
                    {
                        <li><span class="dialed-chip">@L["Bean_Decaf"]</span></li>
                    }
                </ul>
                @if (Dialed.Domain.Flavors.FlavorWheel.Tally(current.TastingNotes) is { Count: >= 2 } shares)
                {
                    <FlavorWheelChart Id="bean-flavor-wheel" Shares="shares" />
                }
            }

            @if (current.Varieties.Count > 0)
            {
                <p class="dialed-bean-line"><span class="dialed-muted">@L["Bean_Varieties"]</span> @string.Join(", ", current.Varieties)</p>
            }

            @if (current.PhotoIds.Count > 0)
            {
                <PhotoStrip PhotoIds="@current.PhotoIds" ReadOnly="true" Label="@L["Photo_Title"].Value" />
            }
            @if (current.Notes is not null)
            {
                <Card class="dialed-card dialed-notes-card"><p class="dialed-vendor-notes">@current.Notes</p></Card>
            }
            <p class="dialed-bean-line dialed-muted">@L["Bean_Visibility"]: @L[$"Visibility_{current.Visibility}"]</p>

            @if (bestRecipe is not null)
            {
                <a id="bean-best-recipe" class="dialed-card dialed-card-link dialed-best-recipe" href="@($"recipes/{bestRecipe.Id}")">
                    <MethodIcon Code="@bestRecipe.MethodCode" />
                    <span class="dialed-row-text">
                        <span class="dialed-row-subtitle">@L["Bean_BestRecipeLabel"]</span>
                        <span class="dialed-row-title">@bestRecipe.Name</span>
                    </span>
                </a>
            }

            <RecipeSuggestionPanel Bean="current" />

            <SectionHeader Title="@L["Bean_BagsHeading"]">
                <Actions><a id="bean-add-bag" class="dialed-section-link" href="@($"bags/new?beanId={current.Id}")">@L["Bean_AddBag"]</a></Actions>
            </SectionHeader>
            @if (currentStock.Count == 0)
            {
                <p class="dialed-muted">@L["Bean_NoBags"]</p>
            }
            else
            {
                <div class="dialed-list" id="bean-bags">
                    @foreach (var item in currentStock)
                    {
                        <ListRow Title="@BagTitle(item.Bag)" Subtitle="@BagSubtitle(item)" Href="@($"bags/{item.Bag.Id}")" data-bag="@item.Bag.Id">
                            <Below>
                                @if (item.Bag.Status != BagStatus.Finished)
                                {
                                    <Meter Label="@string.Format(L["Stock_LeftIn"].Value, BagTitle(item.Bag))" Fraction="@(item.Bag.WeightG > 0 ? (double)(item.RemainingG / item.Bag.WeightG) : 0)"
                                           Tone="@(item.IsLow ? Meter.MeterTone.Warning : Meter.MeterTone.Normal)"
                                           ValueText="@string.Format(L["Stock_LeftOf"].Value, Units.Weight(item.RemainingG), Units.Weight(item.Bag.WeightG))" />
                                }
                            </Below>
                            <Trailing>
                                @if (item.Bag.Status != BagStatus.Finished && item.Freshness != Freshness.Unknown)
                                {
                                    <span class="dialed-chip">@L[$"Fresh_{item.Freshness}"]</span>
                                }
                            </Trailing>
                        </ListRow>
                    }
                </div>
            }

            @if (currentJourney.Count >= 2)
            {
                <SectionHeader Title="@L["Journey_Title"]" />
                <BeanJourneyList Events="currentJourney" />
            }

            @if (currentTrace.Count > 0)
            {
                <SectionHeader Title="@L["Bean_DialInTrace"]" />
                @foreach (var series in currentTrace.Take(3))
                {
                    <DialInChart Id="@($"bean-dialin-{series.MethodCode}")" Series="series" />
                }
            }

            @if (currentBrews.Count > 0)
            {
                <SectionHeader Title="@L["Bean_RecentBrews"]" />
                <div class="dialed-list" id="bean-brews">
                    @foreach (var brew in currentBrews)
                    {
                        <ListRow Title="@BrewTitle(brew)" Subtitle="@BrewSubtitle(brew)" Href="@($"history/{brew.Id}")">
                            <Leading><MethodIcon Code="@brew.MethodCode" /></Leading>
                            <Trailing>
                                @if (brew.Rating is { } rating)
                                {
                                    <RatingBadge Value="rating" />
                                }
                            </Trailing>
                        </ListRow>
                    }
                </div>
            }
        }
    </Detail>
</ListDetailLayout>

@code {
    private IReadOnlyList<Bean>? beans;
    private IReadOnlyList<Bag> bags = [];
    private IReadOnlyList<Vendor> vendors = [];
    private IReadOnlyList<Vendor> roasters = [];
    private Bean? current;
    private IReadOnlyList<Bag> currentBags = [];
    private IReadOnlyList<BagStock> currentStock = [];
    private IReadOnlyList<Brew> currentBrews = [];
    private IReadOnlyList<DialInSeries> currentTrace = [];
    private IReadOnlyList<JourneyEvent> currentJourney = [];
    private bool showFilters;
    private Recipe? bestRecipe;
    private string search = "";
    private string roasterFilter = "";
    private string processFilter = "";
    private string roastFilter = "";
    private string countryFilter = "";
    private bool? stockFilter;
    private BeanSort sort = BeanSort.Name;
    private bool editing;
    private bool sharing;
    private bool confirmingDelete;
    private string? error;

    [Parameter]
    public string? Id { get; set; }

    /// <summary>Opens the list already narrowed to one origin country (the ISO code or the name), e.g. from the maps: <c>beans?country=ET</c>.</summary>
    [SupplyParameterFromQuery(Name = "country")]
    public string? Country { get; set; }

    /// <summary>A scanned barcode to start a new bean with (#104): <c>beans/new?barcode=...</c>.</summary>
    [SupplyParameterFromQuery(Name = "barcode")]
    public string? Barcode { get; set; }

    private Bean? seed;

    /// <summary>For a new bean: <c>null</c>, or an empty bean carrying the scanned code. One instance per visit, so typing does not reset the form.</summary>
    private Bean? NewBeanSeed =>
        Dialed.Domain.Barcodes.BarcodeMatcher.Normalize(Barcode) is { } code
            ? seed is not null && seed.Barcodes.Contains(code) ? seed : seed = new Bean { Name = "", Barcodes = [code] }
            : seed = null;

    private IEnumerable<string> ProcessOptions =>
        BeanQuery.KnownProcesses.Concat((beans ?? []).Select(b => b.Process).OfType<string>())
            .Distinct(StringComparer.OrdinalIgnoreCase).Order(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<Bean> Visible => BeanQuery.Apply(beans ?? [], bags, new BeanFilter(
        search,
        roasterFilter == "" ? null : roasterFilter,
        processFilter == "" ? null : processFilter,
        Enum.TryParse<RoastLevel>(roastFilter, out var level) ? level : null,
        stockFilter,
        countryFilter == "" ? null : countryFilter), sort);

    private RenderFragment Fact(string labelKey, string? value) => __builder =>
    {
        if (value is not null)
        {
            <dt>@L[labelKey]</dt>
            <dd>@value</dd>
        }
    };

    protected override async Task OnInitializedAsync()
    {
        BeanStore.Changed += OnStoreChanged;
        BagStore.Changed += OnStoreChanged;
        VendorStore.Changed += OnStoreChanged;
        RecipeStore.Changed += OnStoreChanged;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Id is null && Country is { Length: > 0 } country)
        {
            countryFilter = Dialed.Domain.Geography.CountryCatalog.Find(country)?.Iso2 ?? country;
            showFilters = true;
        }

        editing = false;
        confirmingDelete = false;
        error = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        beans = await BeanStore.ListAsync();
        bags = await BagStore.ListAsync();
        vendors = await VendorStore.ListAsync();
        roasters = [.. vendors.Where(v => (v.Kinds & VendorKinds.Roaster) != 0).OrderBy(v => v.Name)];
        current = Id is null or "new" ? null : beans.FirstOrDefault(bean => bean.Id == Id);
        currentBags = current is null ? [] : [.. bags.Where(bag => bag.BeanId == current.Id)];
        if (current is not null)
        {
            var brews = await BrewStore.ListAsync();
            var today = DateOnly.FromDateTime(Time.GetLocalNow().DateTime);
            currentStock =
            [
                .. InventoryOverview.Build(currentBags, [current], brews, today, Preferences.Inventory)
                    .OrderBy(s => s.Bag.Status == BagStatus.Finished)
                    .ThenByDescending(s => s.Bag.RoastDate ?? s.Bag.PurchasedOn ?? DateOnly.MinValue),
            ];
            var bagIds = currentBags.Select(b => b.Id).ToHashSet();
            currentBrews = [.. brews.Where(b => !b.Deleted && bagIds.Contains(b.BagId)).OrderByDescending(b => b.BrewedAt).Take(5)];
            currentTrace = DialInTrace.Build(brews.Where(b => bagIds.Contains(b.BagId)));
            currentJourney = BeanJourney.Build(current, currentBags, brews, Preferences.Inventory, today);
        }
        else
        {
            currentStock = [];
            currentBrews = [];
            currentTrace = [];
            currentJourney = [];
        }
        bestRecipe = current is null ? null : RecipeQuery.BestForBean(current.Id, await RecipeStore.ListAsync());
    }

    private void OnStoreChanged() => _ = InvokeAsync(async () =>
    {
        if (editing)
        {
            return;
        }

        await LoadAsync();
        StateHasChanged();
    });

    private int ActiveFilterCount =>
        (roasterFilter == "" ? 0 : 1) + (processFilter == "" ? 0 : 1) + (roastFilter == "" ? 0 : 1) + (countryFilter == "" ? 0 : 1) + (sort == BeanSort.Name ? 0 : 1);

    private int ActiveBags(Bean bean) => bags.Count(b => !b.Deleted && b.BeanId == bean.Id && b.Status != BagStatus.Finished);

    /// <summary>The facts worth a tile; the rest is in chips or a line of text.</summary>
    private List<(string Label, string Value)> KeyFacts(Bean bean)
    {
        var facts = new List<(string, string)>();
        if (bean.Process is { } process)
        {
            facts.Add((L["Bean_Process"].Value, process));
        }

        if (bean.RoastLevel is { } level)
        {
            facts.Add((L["Bean_RoastLevel"].Value, L[$"RoastLevel_{level}"].Value));
        }

        if (bean.RoastStyle is { } style)
        {
            facts.Add((L["Bean_RoastStyle"].Value, L[$"RoastStyle_{style}"].Value));
        }

        if (bean.AltitudeM is { } altitude)
        {
            facts.Add((L["Bean_AltitudeShort"].Value, $"{altitude} m"));
        }

        return facts;
    }

    /// <summary>Makes the picture of this bean (name, roaster, origin on a map, rating, facts, tasting notes) and hands it to the share sheet or a download.</summary>
    private async Task ShareCardAsync()
    {
        if (current is null || sharing)
        {
            return;
        }

        sharing = true;
        error = null;
        try
        {
            var origin = string.Join(", ", new[] { current.Origin.Country, current.Origin.Region }.Where(p => !string.IsNullOrWhiteSpace(p)));
            var facts = KeyFacts(current);
            if (current.Varieties.Count > 0)
            {
                facts.Add((L["Bean_Varieties"].Value, string.Join(", ", current.Varieties)));
            }

            var svg = Dialed.UI.Cards.BeanCard.Build(new Dialed.UI.Cards.BeanCardContent(
                current.Name,
                RoasterName(current),
                origin.Length > 0 ? origin : null,
                current.Rating,
                Dialed.Domain.Geography.CountryCatalog.Find(current.Origin.Country)?.Iso2,
                facts,
                current.TastingNotes.Count > 0 ? string.Join(" · ", current.TastingNotes) : null,
                L["BeanCard_Footer"].Value));
            var png = await Images.SvgToPngAsync(svg, Dialed.UI.Cards.BeanCard.Width, Dialed.UI.Cards.BeanCard.Height);
            if (png is null)
            {
                error = L["Card_Failed"].Value;
                return;
            }

            await Files.SaveAsync("dialed-bean.png", "image/png", png);
        }
        finally
        {
            sharing = false;
        }
    }

    private static string Date(DateOnly date) => date.ToString("d MMM yyyy", CultureInfo.CurrentCulture);

    private string BagTitle(Bag bag) =>
        bag.RoastDate is { } roasted ? string.Format(L["Bag_RoastedOn"].Value, Date(roasted)) : Units.Weight(bag.WeightG);

    private string BagSubtitle(BagStock item)
    {
        var status = L[$"BagStatus_{item.Bag.Status}"].Value;
        return item.Bag.Status == BagStatus.Finished
            ? $"{Units.Weight(item.Bag.WeightG)} · {status}"
            : $"{string.Format(L["Stock_LeftOf"].Value, Units.Weight(item.RemainingG), Units.Weight(item.Bag.WeightG))} · {status}";
    }

    private string BrewTitle(Brew brew) =>
        (brew.WaterG ?? brew.YieldG) is { } liquid ? $"{Units.Weight(brew.DoseG)} → {Units.Weight(liquid)}" : Units.Weight(brew.DoseG);

    private string BrewSubtitle(Brew brew) =>
        $"{brew.BrewedAt.ToLocalTime().ToString("d MMM", CultureInfo.CurrentCulture)} · {BrewMethodCatalog.Default.Find(brew.MethodCode)?.Name ?? brew.MethodCode}";

    private string? RoasterName(Bean bean) => vendors.FirstOrDefault(v => v.Id == bean.RoasterId)?.Name;

    private static string? OriginText(Bean bean)
    {
        var parts = new[] { bean.Origin.Country, bean.Origin.Region, bean.Origin.Farm, bean.Origin.Producer }
            .Where(p => !string.IsNullOrWhiteSpace(p));
        var text = string.Join(", ", parts);
        return text.Length == 0 ? null : text;
    }

    private string? Subtitle(Bean bean)
    {
        var parts = new[] { RoasterName(bean), bean.Origin.Country }.Where(p => !string.IsNullOrWhiteSpace(p));
        var text = string.Join(" · ", parts);
        return text.Length == 0 ? null : text;
    }

    private async Task CreateAsync(Bean bean)
    {
        var saved = await BeanStore.SaveAsync(bean);
        Navigation.NavigateTo($"beans/{saved.Id}");
    }

    private async Task UpdateAsync(Bean bean)
    {
        try
        {
            await BeanStore.SaveAsync(bean);
            error = null;
        }
        catch (ConflictException)
        {
            error = L["Error_Conflict"];
        }

        editing = false;
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (current is null)
        {
            return;
        }

        // A bag has no meaning without its bean, so its bags go with it.
        foreach (var bag in currentBags)
        {
            await BagStore.DeleteAsync(bag.Id);
        }

        await BeanStore.DeleteAsync(current.Id);
        Navigation.NavigateTo("beans");
    }

    public void Dispose()
    {
        BeanStore.Changed -= OnStoreChanged;
        BagStore.Changed -= OnStoreChanged;
        VendorStore.Changed -= OnStoreChanged;
        RecipeStore.Changed -= OnStoreChanged;
    }
}
