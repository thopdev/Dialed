@page "/bags"
@page "/bags/{Id}"
@using System.Globalization
@using Dialed.Client.Data
@using Dialed.Client.Preferences
@using Dialed.Domain.Inventory
@using Dialed.Domain.Model
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject IRepository<Bag> BagStore
@inject IRepository<Bean> BeanStore
@inject IRepository<Vendor> VendorStore
@inject IRepository<Brew> BrewStore
@inject UnitFormatter Units
@inject IUserPreferences Preferences
@inject NavigationManager Navigation
@inject TimeProvider Time

<ListDetailLayout HasSelection="@(Id is not null)">
    <List>
        <PageHeader Title="@L["Bags_Title"]" BackHref="more">
            <Actions>
                <a class="dialed-button dialed-button-primary" href="bags/new">@L["Bags_New"]</a>
            </Actions>
        </PageHeader>

        @if (bags is null)
        {
            <Loading IsLoading="true" />
        }
        else if (bags.Count == 0)
        {
            <EmptyState Icon="@(new Icons.Regular.Size24.Box())" Message="@L["Bags_Empty"]">
                <a class="dialed-button dialed-button-primary" href="bags/new">@L["Bags_New"]</a>
            </EmptyState>
        }
        else
        {
            <ChipGroup Label="@L["Bags_Filter"]">
                <Chip Selected="@(!showFinished)" OnClick="@(() => showFinished = false)">@L["Bags_Active"]</Chip>
                <Chip Selected="@showFinished" OnClick="@(() => showFinished = true)">@L["Bags_All"]</Chip>
            </ChipGroup>

            @if (Visible.Count == 0)
            {
                <EmptyState Message="@L["Bags_NoResults"]" />
            }
            else
            {
                <div class="dialed-list">
                    @foreach (var bag in Visible)
                    {
                        var item = StockOf(bag);
                        <ListRow Title="@BeanName(bag.BeanId)" Subtitle="@Summary(bag)" Href="@($"bags/{bag.Id}")" data-bag="@bag.Id">
                            <Leading><RoastThumb PhotoId="@BeanOf(bag)?.PhotoIds.FirstOrDefault()" Level="@BeanOf(bag)?.RoastLevel" /></Leading>
                            <Below>
                                @if (item is not null && bag.Status != BagStatus.Finished)
                                {
                                    <Meter Label="@string.Format(L["Stock_LeftIn"].Value, BeanName(bag.BeanId))" Fraction="@Fraction(item)"
                                           Tone="@(item.IsLow ? Meter.MeterTone.Warning : Meter.MeterTone.Normal)"
                                           ValueText="@string.Format(L["Stock_LeftOf"].Value, Units.Weight(item.RemainingG), Units.Weight(bag.WeightG))" />
                                }
                            </Below>
                            <Trailing>
                                @if (item is not null && bag.Status != BagStatus.Finished && item.Freshness != Freshness.Unknown)
                                {
                                    <span class="dialed-chip">@L[$"Fresh_{item.Freshness}"]</span>
                                }
                            </Trailing>
                        </ListRow>
                    }
                </div>
            }
        }
    </List>
    <Detail>
        @if (Id is null)
        {
            <EmptyState Icon="@(new Icons.Regular.Size24.Box())" Message="@L["Bags_SelectPrompt"]" />
        }
        else if (Id == "new")
        {
            <PageHeader Title="@L["Bags_New"]" BackHref="bags" />
            <BagForm Beans="beans" BeanId="@BeanId" Today="Today" OnSubmit="CreateAsync" OnCancel="@(() => Navigation.NavigateTo("bags"))" />
        }
        else if (current is null)
        {
            <PageHeader Title="@L["Bags_Title"]" BackHref="bags" />
            <EmptyState Message="@L["Bags_NotFound"]" />
        }
        else if (editing)
        {
            <PageHeader Title="@BeanName(current.BeanId)" BackHref="bags" />
            <BagForm Bag="current" Beans="beans" OnSubmit="UpdateAsync" OnCancel="@(() => editing = false)" />
        }
        else
        {
            <PageHeader Title="@BeanName(current.BeanId)" BackHref="bags">
                <Actions>
                    <button type="button" id="bag-edit" class="dialed-icon-button" aria-label="@L["Edit"]" title="@L["Edit"]" @onclick="@(() => editing = true)">
                        <FluentIcon Value="@(new Icons.Regular.Size24.Edit())" Color="Color.Custom" CustomColor="currentColor" />
                    </button>
                    <button type="button" id="bag-delete" class="dialed-icon-button" aria-label="@L["Delete"]" title="@L["Delete"]" @onclick="@(() => confirmingDelete = true)">
                        <FluentIcon Value="@(new Icons.Regular.Size24.Delete())" Color="Color.Custom" CustomColor="currentColor" />
                    </button>
                </Actions>
            </PageHeader>

            @if (error is not null)
            {
                <ErrorBanner Message="@error" />
            }

            @if (confirmingDelete)
            {
                <div class="dialed-confirm" role="alertdialog" aria-label="@L["Bag_DeleteTitle"]">
                    <p><strong>@L["Bag_DeleteTitle"]</strong></p>
                    <p>@L["Bag_DeleteBody"]</p>
                    <div class="dialed-form-actions">
                        <button type="button" class="dialed-button dialed-button-danger" @onclick="DeleteAsync">@L["Delete"]</button>
                        <button type="button" class="dialed-button" @onclick="@(() => confirmingDelete = false)">@L["Cancel"]</button>
                    </div>
                </div>
            }

            @if (BagInventory.ShouldOfferFinish(current.Status, remaining))
            {
                <div class="dialed-confirm" role="status" id="bag-offer-finish">
                    <p>@L["Bag_OfferFinish"]</p>
                    <div class="dialed-form-actions">
                        <button type="button" class="dialed-button dialed-button-primary" @onclick="@(() => Step(BagLifecycle.TryFinish))">@L["Bag_Finish"]</button>
                    </div>
                </div>
            }

            <Card class="dialed-card dialed-bag-summary" id="bag-summary">
                <div class="dialed-bag-summary-top">
                    <RoastThumb PhotoId="@BeanOf(current)?.PhotoIds.FirstOrDefault()" Level="@BeanOf(current)?.RoastLevel" Size="72" />
                    <div>
                        <span class="dialed-chip dialed-chip-status" id="bag-status">@L[$"BagStatus_{current.Status}"]</span>
                        <p class="dialed-muted dialed-bag-storage">@L[$"BagStorage_{current.Storage}"]</p>
                    </div>
                </div>
                <div class="dialed-stat-grid">
                    <StatTile Value="@Units.Weight(BagInventory.Display(remaining))" Label="@L["Bag_Remaining"]" Hint="@string.Format(L["Bag_OfWeight"].Value, Units.Weight(current.WeightG))" />
                    @if (BagLifecycle.AgeDays(current, Today) is { } ageDays)
                    {
                        <StatTile Value="@string.Format(L["Bag_DaysShort"].Value, ageDays)" Label="@L["Bag_Age"]" Hint="@(current.FrozenDays > 0 || current.Status == BagStatus.Frozen ? L["Bag_AgeFrozenHint"].Value : null)" />
                    }
                    @if (current.PriceCents is { } priceCents)
                    {
                        <StatTile Value="@Price(priceCents, current.Currency)" Label="@L["Bag_PriceShort"]" />
                    }
                </div>
                @if (current.Status != BagStatus.Finished)
                {
                    <Meter Label="@L["Bag_Remaining"]" Fraction="@(current.WeightG > 0 ? (double)(BagInventory.Display(remaining) / current.WeightG) : 0)"
                           Tone="@(BagInventory.Display(remaining) < Preferences.Inventory.LowStockG ? Meter.MeterTone.Warning : Meter.MeterTone.Normal)"
                           ValueText="@string.Format(L["Stock_LeftOf"].Value, Units.Weight(BagInventory.Display(remaining)), Units.Weight(current.WeightG))" />
                }
            </Card>

            @if (current.Status != BagStatus.Finished && BagLifecycle.AgeDays(current, Today) is { } age)
            {
                <SectionHeader Title="@L["Bag_Freshness"]" />
                <FreshnessTimeline Id="bag-freshness" AgeDays="age" Window="@Preferences.Inventory.RestWindows.For(BeanOf(current)?.RoastLevel)" RestDaysOverride="current.RestDaysOverride" />
            }

            <SectionHeader Title="@L["Bag_Details"]" />
            <dl class="dialed-facts" id="bag-facts">
                @if (SellerName(current) is { } seller)
                {
                    <dt>@L["Bag_Seller"]</dt>
                    <dd><a href="@($"vendors/{current.SellerId}")">@seller</a></dd>
                }
                @DateFact("Bag_RoastDate", current.RoastDate)
                @DateFact("Bag_PurchasedOn", current.PurchasedOn)
                @DateFact("Bag_OpenedOn", current.OpenedOn)
                @DateFact("Bag_FrozenSince", current.FrozenOn)
                @DateFact("Bag_FinishedOn", current.FinishedOn)
            </dl>

            @if (current.Status != BagStatus.Finished)
            {
                <SectionHeader Title="@L["Bag_NextStep"]" />
                <div class="dialed-bag-steps">
                    <div class="dialed-field">
                        <label for="bag-step-date">@L["Bag_StepDate"]</label>
                        <input id="bag-step-date" type="date" @bind="stepDate" />
                    </div>
                    <div class="dialed-form-actions">
                        @if (BagLifecycle.CanOpen(current))
                        {
                            <button type="button" id="bag-open" class="dialed-button dialed-button-primary" @onclick="@(() => Step(BagLifecycle.TryOpen))">@L["Bag_Open"]</button>
                        }
                        @if (BagLifecycle.CanFreeze(current))
                        {
                            <button type="button" id="bag-freeze" class="dialed-button" @onclick="@(() => Step(BagLifecycle.TryFreeze))">@L["Bag_Freeze"]</button>
                        }
                        @if (BagLifecycle.CanThaw(current))
                        {
                            <button type="button" id="bag-thaw" class="dialed-button dialed-button-primary" @onclick="@(() => Step(BagLifecycle.TryThaw))">@L["Bag_Thaw"]</button>
                        }
                        <button type="button" id="bag-finish" class="dialed-button" @onclick="@(() => Step(BagLifecycle.TryFinish))">@L["Bag_Finish"]</button>
                    </div>
                </div>
            }

            <div class="dialed-form-actions dialed-bag-again">
                <button type="button" id="bag-bought-again" class="dialed-button dialed-button-icon" @onclick="BoughtAgainAsync">
                    <span class="dialed-button-glyph" aria-hidden="true"><FluentIcon Value="@(new Icons.Regular.Size20.ArrowRepeatAll())" Color="Color.Custom" CustomColor="currentColor" /></span>
                    @L["Bag_BoughtAgain"]
                </button>
            </div>
        }
    </Detail>
</ListDetailLayout>

@code {
    private delegate bool LifecycleStep(Bag bag, DateOnly date, out Bag result);

    private IReadOnlyList<Bag>? bags;
    private IReadOnlyList<Bean> beans = [];
    private IReadOnlyList<Vendor> vendors = [];
    private IReadOnlyList<Brew> brews = [];
    private Dictionary<string, BagStock> stockByBag = [];
    private Bag? current;
    private decimal remaining;
    private bool showFinished;
    private bool editing;
    private bool confirmingDelete;
    private string? error;
    private DateOnly? stepDate;

    [Parameter]
    public string? Id { get; set; }

    /// <summary>Preselects the bean when adding a bag from a bean's page.</summary>
    [Parameter, SupplyParameterFromQuery(Name = "beanId")]
    public string? BeanId { get; set; }

    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

    private IReadOnlyList<Bag> Visible =>
        [.. (bags ?? []).Where(bag => showFinished || bag.Status != BagStatus.Finished)
            .OrderBy(bag => bag.Status == BagStatus.Finished)
            .ThenByDescending(bag => bag.PurchasedOn ?? DateOnly.MinValue)
            .ThenByDescending(bag => bag.CreatedAt)];

    private RenderFragment DateFact(string labelKey, DateOnly? date) => __builder =>
    {
        if (date is { } value)
        {
            <dt>@L[labelKey]</dt>
            <dd>@value.ToString("d MMM yyyy", CultureInfo.CurrentCulture)</dd>
        }
    };

    protected override async Task OnInitializedAsync()
    {
        BagStore.Changed += OnStoreChanged;
        BeanStore.Changed += OnStoreChanged;
        VendorStore.Changed += OnStoreChanged;
        BrewStore.Changed += OnStoreChanged;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        editing = false;
        confirmingDelete = false;
        error = null;
        stepDate = Today;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        bags = await BagStore.ListAsync();
        beans = [.. (await BeanStore.ListAsync()).OrderBy(bean => bean.Name)];
        vendors = await VendorStore.ListAsync();
        current = Id is null or "new" ? null : bags.FirstOrDefault(bag => bag.Id == Id);

        brews = await BrewStore.ListAsync();
        stockByBag = InventoryOverview.Build(bags, beans, brews, Today, Preferences.Inventory).ToDictionary(s => s.Bag.Id);
        remaining = current is null ? 0m : BagInventory.Remaining(current.WeightG, brews.Where(b => b.BagId == current.Id && !b.Deleted).Select(b => b.DoseG), []);
    }

    private void OnStoreChanged() => _ = InvokeAsync(async () =>
    {
        if (editing)
        {
            return;
        }

        await LoadAsync();
        StateHasChanged();
    });

    private string BeanName(string beanId) => beans.FirstOrDefault(bean => bean.Id == beanId)?.Name ?? L["Bag_UnknownBean"].Value;

    private BagStock? StockOf(Bag bag) => stockByBag.GetValueOrDefault(bag.Id);

    private Bean? BeanOf(Bag bag) => beans.FirstOrDefault(bean => bean.Id == bag.BeanId);

    private static double Fraction(BagStock item) => item.Bag.WeightG > 0 ? (double)(item.RemainingG / item.Bag.WeightG) : 0;

    private static string Price(int cents, string? currency) =>
        $"{(cents / 100m).ToString("N2", CultureInfo.CurrentCulture)} {currency}".Trim();

    private string? SellerName(Bag bag) => vendors.FirstOrDefault(vendor => vendor.Id == bag.SellerId)?.Name;

    private string Summary(Bag bag)
    {
        var parts = new List<string> { Units.Weight(bag.WeightG), L[$"BagStatus_{bag.Status}"].Value };
        if (BagLifecycle.AgeDays(bag, Today) is { } age && bag.Status != BagStatus.Finished)
        {
            parts.Add(string.Format(L["Bag_AgeShort"].Value, age));
        }

        return string.Join(" · ", parts);
    }

    private async Task CreateAsync(Bag bag)
    {
        var saved = await BagStore.SaveAsync(bag with { Status = BagStatus.Sealed });
        Navigation.NavigateTo($"bags/{saved.Id}");
    }

    private async Task UpdateAsync(Bag bag)
    {
        try
        {
            await BagStore.SaveAsync(bag);
            error = null;
        }
        catch (ConflictException)
        {
            error = L["Error_Conflict"];
        }

        editing = false;
        await LoadAsync();
    }

    private async Task Step(LifecycleStep step)
    {
        if (current is null)
        {
            return;
        }

        if (step(current, stepDate ?? Today, out var changed))
        {
            try
            {
                await BagStore.SaveAsync(changed);
                error = null;
            }
            catch (ConflictException)
            {
                error = L["Error_Conflict"];
            }
        }
        else
        {
            error = L["Bag_StepInvalid"];
        }

        await LoadAsync();
    }

    private async Task BoughtAgainAsync()
    {
        if (current is null)
        {
            return;
        }

        var saved = await BagStore.SaveAsync(BagLifecycle.BoughtAgain(current, Today));
        Navigation.NavigateTo($"bags/{saved.Id}");
    }

    private async Task DeleteAsync()
    {
        if (current is null)
        {
            return;
        }

        await BagStore.DeleteAsync(current.Id);
        Navigation.NavigateTo("bags");
    }

    public void Dispose()
    {
        BagStore.Changed -= OnStoreChanged;
        BeanStore.Changed -= OnStoreChanged;
        VendorStore.Changed -= OnStoreChanged;
        BrewStore.Changed -= OnStoreChanged;
    }
}
