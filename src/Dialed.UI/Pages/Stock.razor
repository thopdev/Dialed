@page "/inventory"
@using Dialed.Client.Data
@using Dialed.Client.Preferences
@using Dialed.Domain.Inventory
@using Dialed.Domain.Model
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject IRepository<Bag> BagStore
@inject IRepository<Bean> BeanStore
@inject IRepository<Brew> BrewStore
@inject IUserPreferences Preferences
@inject TimeProvider Time
@inject Dialed.Client.Platform.IShareService Sharing
@inject UnitFormatter Units

<PageHeader Title="@L["Stock_Title"]" BackHref="more" />

@if (Filter is not null)
{
    <p id="stock-filter" class="dialed-banner dialed-banner-info" role="status">
        @L[Filter == "low" ? "Stock_FilterLow" : "Stock_FilterPeak"]
        <a id="stock-filter-clear" class="dialed-section-link" href="inventory">@L["Stock_ShowAll"]</a>
    </p>
}

@if (stock is not null && shopping.Count > 0 && Filter is null)
{
    <section id="stock-shopping">
        <SectionHeader Title="@L["Shopping_Title"]" />
        <div class="dialed-list">
            @foreach (var item in shopping)
            {
                <ListRow Title="@item.Name" Subtitle="@ShoppingSubtitle(item)" Href="@($"beans/{item.BeanId}")" data-bean="@item.BeanId" />
            }
        </div>
        <div class="dialed-form-actions">
            <button id="stock-share-list" type="button" class="dialed-button" @onclick="ShareListAsync">@L["Shopping_Share"]</button>
        </div>
        @if (listText is not null)
        {
            <div class="dialed-field">
                <label for="stock-list-text">@L["Shopping_Copy"]</label>
                <textarea id="stock-list-text" readonly rows="@(shopping.Count + 1)">@listText</textarea>
            </div>
        }
    </section>
}

@if (stock is null)
{
    <Loading IsLoading="true" />
}
else if (Groups.All(g => g.Items.Count == 0) && Filter is not null)
{
    <EmptyState Icon="@(new Icons.Regular.Size24.Box())" Message="@L["Stock_FilterNone"]" />
}
else if (Groups.All(g => g.Items.Count == 0))
{
    <EmptyState Icon="@(new Icons.Regular.Size24.Box())" Message="@L["Stock_Empty"]">
        <a class="dialed-button dialed-button-primary" href="bags/new">@L["Bags_New"]</a>
    </EmptyState>
}
else
{
    @foreach (var group in Groups.Where(g => g.Items.Count > 0))
    {
        <section data-group="@group.Status.ToString().ToLowerInvariant()">
            <SectionHeader Title="@L[$"Stock_Group_{group.Status}"]">
                <Actions><span class="dialed-count" aria-label="@string.Format(L["Stock_Count"].Value, group.Items.Count)">@group.Items.Count</span></Actions>
            </SectionHeader>
            <div class="dialed-list">
                @foreach (var item in group.Items)
                {
                    <BagStockRow Stock="item" PhotoId="@Bean(item)?.PhotoIds.FirstOrDefault()" RoastLevel="@Bean(item)?.RoastLevel" />
                }
            </div>
        </section>
    }
}

@code {
    private IReadOnlyList<BagStock>? stock;
    private Dictionary<string, Bean> beansById = [];
    private IReadOnlyList<ShoppingItem> shopping = [];
    private string? listText;

    /// <summary>A tapped stock notification opens this page with <c>?show=low</c> or <c>?show=peak</c> (#259).</summary>
    [SupplyParameterFromQuery(Name = "show")]
    public string? Show { get; set; }

    private string? Filter => Show is "low" or "peak" ? Show : null;

    private bool Matches(BagStock s) => Filter switch
    {
        "low" => s.IsLow,
        "peak" => s.Freshness == Freshness.Peak && s.Bag.Status is BagStatus.Open or BagStatus.Sealed,
        _ => true,
    };

    private Bean? Bean(BagStock item) => beansById.GetValueOrDefault(item.Bag.BeanId);

    private IEnumerable<(BagStatus Status, IReadOnlyList<BagStock> Items)> Groups =>
        new[] { BagStatus.Open, BagStatus.Sealed, BagStatus.Frozen }.Select(status =>
            (status, (IReadOnlyList<BagStock>)[.. (stock ?? []).Where(s => s.Bag.Status == status && Matches(s)).OrderBy(s => s.BeanName, StringComparer.OrdinalIgnoreCase)]));

    protected override async Task OnInitializedAsync()
    {
        BagStore.Changed += OnChanged;
        BeanStore.Changed += OnChanged;
        BrewStore.Changed += OnChanged;
        Preferences.Changed += OnChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var today = DateOnly.FromDateTime(Time.GetLocalNow().DateTime);
        var beans = await BeanStore.ListAsync();
        beansById = beans.Where(b => !b.Deleted).ToDictionary(b => b.Id);
        var brews = await BrewStore.ListAsync();
        stock = InventoryOverview.Build(await BagStore.ListAsync(), beans, brews, today, Preferences.Inventory);
        shopping = ShoppingList.Build(stock, brews);
    }

    private string ShoppingSubtitle(ShoppingItem item)
    {
        var reason = L[item.Reason == ShoppingReason.RunningLow ? "Shopping_Low" : "Shopping_Again"].Value;
        return item.LastBagWeightG is { } weight ? $"{reason} · {Units.Weight(weight)}" : reason;
    }

    private async Task ShareListAsync()
    {
        var lines = shopping.Select(i => $"- {i.Name}{(i.LastBagWeightG is { } w ? $" ({Units.Weight(w)})" : "")}");
        var text = $"{L["Shopping_Title"].Value}\n{string.Join("\n", lines)}";
        if (await Sharing.IsSupportedAsync() && await Sharing.ShareAsync(new Dialed.Client.Platform.ShareRequest(Title: L["Shopping_Title"].Value, Text: text)))
        {
            listText = null;
            return;
        }

        // No share sheet (or it was dismissed): show the text to copy by hand.
        listText = text;
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose()
    {
        BagStore.Changed -= OnChanged;
        BeanStore.Changed -= OnChanged;
        BrewStore.Changed -= OnChanged;
        Preferences.Changed -= OnChanged;
    }
}
