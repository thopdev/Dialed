@page "/history"
@page "/history/{Id}"
@using System.Globalization
@using Dialed.Client.Data
@using Dialed.Client.Households
@using Dialed.Client.Preferences
@using Dialed.Domain.BrewMethods
@using Dialed.Domain.Model
@using Dialed.Domain.Statistics
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject IRepository<Brew> BrewStore
@inject IRepository<Bag> BagStore
@inject IRepository<Bean> BeanStore
@inject IRepository<Recipe> RecipeStore
@inject IRepository<EquipmentItem> GearStore
@inject ICurrentContext Context
@inject UnitFormatter Units
@inject HouseholdManager Households
@inject TimeProvider Time
@inject NavigationManager Navigation
@inject Dialed.Client.Platform.IFileExport Files
@inject Dialed.Client.Platform.IImageRenderer Images

<ListDetailLayout HasSelection="@(Id is not null)">
    <List>
        <PageHeader Title="@L["History_Title"]" BackHref="more" />

        @if (brews is null)
        {
            <Loading IsLoading="true" />
        }
        else if (brews.Count == 0)
        {
            <EmptyState Icon="@(new Icons.Regular.Size24.History())" Message="@L["History_Empty"]">
                <a class="dialed-button dialed-button-primary" href="brew">@L["Home_LogBrew"]</a>
            </EmptyState>
        }
        else
        {
            <div class="dialed-filter-bar">
                <button type="button" id="history-filters-toggle" class="dialed-button dialed-button-icon @(showFilters ? "dialed-button-pressed" : "")"
                        aria-expanded="@(showFilters ? "true" : "false")" aria-controls="history-filters" @onclick="@(() => showFilters = !showFilters)">
                    <span class="dialed-button-glyph" aria-hidden="true"><FluentIcon Value="@(new Icons.Regular.Size20.Filter())" Color="Color.Custom" CustomColor="currentColor" /></span>
                    @(ActiveFilterCount > 0 ? string.Format(L["Beans_FiltersCount"].Value, ActiveFilterCount) : L["Beans_Filters"].Value)
                </button>
                <span class="dialed-muted dialed-filter-summary" id="history-count">@string.Format(L[Visible.Count == 1 ? "History_CountOne" : "History_Count"].Value, Visible.Count)</span>
            </div>
            <div class="dialed-filters" id="history-filters" hidden="@(!showFilters)">
                <div class="dialed-field">
                    <label for="history-bean">@L["Recipe_Bean"]</label>
                    <select id="history-bean" @bind="beanFilter">
                        <option value="">@L["Beans_Any"]</option>
                        @foreach (var bean in beans)
                        {
                            <option value="@bean.Id">@bean.Name</option>
                        }
                    </select>
                </div>
                <div class="dialed-field">
                    <label for="history-method">@L["Recipe_Method"]</label>
                    <select id="history-method" @bind="methodFilter">
                        <option value="">@L["Beans_Any"]</option>
                        @foreach (var methodCode in brews.Select(b => b.MethodCode).Distinct().Order())
                        {
                            <option value="@methodCode">@MethodName(methodCode)</option>
                        }
                    </select>
                </div>
                <div class="dialed-field">
                    <label for="history-person">@L["History_Person"]</label>
                    <select id="history-person" @bind="personFilter">
                        <option value="">@L["Beans_Any"]</option>
                        @foreach (var person in brews.Select(b => b.CreatedBy).Distinct().Order())
                        {
                            <option value="@person">@PersonName(person)</option>
                        }
                    </select>
                </div>
                <div class="dialed-field">
                    <label for="history-rating">@L["History_MinRating"]</label>
                    <select id="history-rating" @bind="ratingFilter">
                        <option value="0">@L["Beans_Any"]</option>
                        @for (var stars = 1; stars <= 5; stars++)
                        {
                            <option value="@stars">@stars ★</option>
                        }
                    </select>
                </div>
            </div>

            @if (Visible.Count == 0)
            {
                <EmptyState Icon="@(new Icons.Regular.Size24.Search())" Message="@L["Beans_NoResults"]" />
            }
            else
            {
                @foreach (var day in Days)
                {
                    <section class="dialed-day-group" data-day="@day.Key.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" aria-labelledby="@($"day-{day.Key:yyyyMMdd}")">
                        <h2 class="dialed-day-title" id="@($"day-{day.Key:yyyyMMdd}")">@DayTitle(day.Key)</h2>
                        <div class="dialed-list">
                            @foreach (var brew in day)
                            {
                                <ListRow Title="@BeanOf(brew)" Subtitle="@Subtitle(brew)" Href="@($"history/{brew.Id}")" data-brew="@brew.Id">
                                    <Leading><MethodIcon Code="@brew.MethodCode" /></Leading>
                                    <Below>
                                        @if (ShowsPeople || !brew.Taste.IsBalanced)
                                        {
                                            <span class="dialed-row-chips">
                                                @if (ShowsPeople)
                                                {
                                                    <span class="dialed-row-person"><Avatar Name="@PersonName(brew.CreatedBy)" Size="20" /> @PersonName(brew.CreatedBy)</span>
                                                }
                                                @foreach (var note in TasteNotes(brew.Taste))
                                                {
                                                    <span class="dialed-chip dialed-chip-small">@note</span>
                                                }
                                            </span>
                                        }
                                    </Below>
                                    <Trailing>
                                        @if (brew.Rating is { } rating)
                                        {
                                            <RatingBadge Value="rating" />
                                        }
                                    </Trailing>
                                </ListRow>
                            }
                        </div>
                    </section>
                }
            }
        }
    </List>
    <Detail>
        @if (Id is null)
        {
            <EmptyState Icon="@(new Icons.Regular.Size24.History())" Message="@L["History_SelectPrompt"]" />
        }
        else if (current is null)
        {
            <PageHeader Title="@L["History_Title"]" BackHref="history" />
            <EmptyState Message="@L["History_NotFound"]" />
        }
        else if (editing)
        {
            <PageHeader Title="@BeanOf(current)" BackHref="history" />
            <BrewForm Initial="current" Gear="gear" OnSubmit="UpdateAsync" OnCancel="@(() => editing = false)" />
        }
        else
        {
            <PageHeader Title="@BeanOf(current)" BackHref="history">
                <Actions>
                    @if (IsMine(current))
                    {
                    <button type="button" id="history-share-card" class="dialed-icon-button" aria-label="@L["Card_Share"]" title="@L["Card_Share"]" disabled="@sharing" @onclick="ShareCardAsync">
                        <FluentIcon Value="@(new Icons.Regular.Size24.Share())" Color="Color.Custom" CustomColor="currentColor" />
                    </button>
                        <button type="button" id="history-edit" class="dialed-icon-button" aria-label="@L["Edit"]" title="@L["Edit"]" @onclick="@(() => editing = true)">
                            <FluentIcon Value="@(new Icons.Regular.Size24.Edit())" Color="Color.Custom" CustomColor="currentColor" />
                        </button>
                        <button type="button" id="history-delete" class="dialed-icon-button" aria-label="@L["Delete"]" title="@L["Delete"]" @onclick="@(() => confirmingDelete = true)">
                            <FluentIcon Value="@(new Icons.Regular.Size24.Delete())" Color="Color.Custom" CustomColor="currentColor" />
                        </button>
                    }
                </Actions>
            </PageHeader>

            @if (error is not null)
            {
                <ErrorBanner Message="@error" />
            }

            @if (confirmingDelete)
            {
                <div class="dialed-confirm" role="alertdialog" aria-label="@L["History_DeleteTitle"]">
                    <p><strong>@L["History_DeleteTitle"]</strong></p>
                    <p>@L["History_DeleteBody"]</p>
                    <div class="dialed-form-actions">
                        <button type="button" class="dialed-button dialed-button-danger" @onclick="DeleteAsync">@L["Delete"]</button>
                        <button type="button" class="dialed-button" @onclick="@(() => confirmingDelete = false)">@L["Cancel"]</button>
                    </div>
                </div>
            }

            <Card class="dialed-card dialed-brew-summary" id="history-summary">
                <div class="dialed-brew-summary-top">
                    <MethodIcon Code="@current.MethodCode" Size="56" />
                    <div class="dialed-brew-summary-text">
                        <span class="dialed-brew-summary-what" id="history-what">@WhatText(current)</span>
                        <span class="dialed-muted" id="history-when">@WhenText(current.BrewedAt)</span>
                        @if (current.Rating is { } stars)
                        {
                            <StarRating Value="stars" ReadOnly="true" />
                        }
                    </div>
                </div>
                @if (CostText is { } cost)
                {
                    <p id="history-cost" class="dialed-muted">@string.Format(L["History_Cost"].Value, cost)</p>
                }
                <p class="dialed-person"><Avatar Name="@PersonName(current.CreatedBy)" Size="28" /> <span id="history-person-name">@PersonName(current.CreatedBy)</span></p>
            </Card>

            <SectionHeader Title="@L["History_Parameters"]" />
            <table class="dialed-compare">
                <thead>
                    <tr><th><span class="dialed-visually-hidden">@L["History_ParameterColumn"]</span></th><th>@L["History_Planned"]</th><th>@L["History_Actual"]</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in comparison)
                    {
                        <tr class="@(row.Differs ? "differs" : null)" data-parameter="@row.Parameter">
                            <th scope="row">@ParameterLabel(row.Parameter)</th>
                            <td>@Format(row.Parameter, row.Planned)</td>
                            <td>@Format(row.Parameter, row.Actual)</td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (recipe is not null)
            {
                <a id="history-recipe" class="dialed-card dialed-card-link dialed-best-recipe" href="@($"recipes/{recipe.Id}")">
                    <MethodIcon Code="@recipe.MethodCode" />
                    <span class="dialed-row-text">
                        <span class="dialed-row-subtitle">@L["History_RecipeLabel"]</span>
                        <span class="dialed-row-title">@recipe.Name</span>
                    </span>
                </a>
            }

            <SectionHeader Title="@L["Brew_Taste"]" />
            <TasteChart Id="history-taste" Taste="current.Taste" />

            @if (Siblings.Count > 0)
            {
                <SectionHeader Title="@L["Compare_Title"]" />
                <div id="history-compare" class="dialed-form">
                    <div class="dialed-field">
                        <label for="history-compare-with">@L["Compare_With"]</label>
                        <select id="history-compare-with" @bind="compareWith">
                            <option value="">@L["Compare_Pick"]</option>
                            @foreach (var other in Siblings)
                            {
                                <option value="@other.Id">@SiblingLabel(other)</option>
                            }
                        </select>
                    </div>
                    <div class="dialed-form-actions">
                        <button id="history-compare-go" type="button" class="dialed-button" disabled="@(compareWith == "")" @onclick="CompareAsync">@L["Compare_Go"]</button>
                    </div>
                </div>
            }

            <DialInAdviceCard Brew="current" Scale="@gear.FirstOrDefault(g => g.Id == current.GrinderId)?.GrindScale" />

            @if (current.PhotoIds.Count > 0 || current.Notes is not null)
            {
                <SectionHeader Title="@L["History_NotesAndPhotos"]" />
                @if (current.PhotoIds.Count > 0)
                {
                    <PhotoStrip PhotoIds="@current.PhotoIds" ReadOnly="true" Label="@L["Photo_Title"].Value" />
                }
                @if (current.Notes is not null)
                {
                    <Card class="dialed-card dialed-notes-card" id="history-notes"><p class="dialed-vendor-notes">@current.Notes</p></Card>
                }
            }
        }
    </Detail>
</ListDetailLayout>

@code {
    private IReadOnlyList<Brew>? brews;
    private IReadOnlyList<Bag> bags = [];
    private IReadOnlyList<Bean> beans = [];
    private IReadOnlyList<EquipmentItem> gear = [];
    private IReadOnlyList<ParameterDelta> comparison = [];
    private Brew? current;
    private Recipe? recipe;
    private string beanFilter = "";
    private string methodFilter = "";
    private string personFilter = "";
    private int ratingFilter;
    private bool editing;
    private bool showFilters;
    private Dictionary<string, string> memberNames = [];
    private bool confirmingDelete;
    private bool sharing;
    private string compareWith = "";
    private string? error;

    [Parameter]
    public string? Id { get; set; }

    private IReadOnlyList<Brew> Visible => BrewHistory.Apply(brews ?? [], bags, new BrewFilter(
        beanFilter == "" ? null : beanFilter,
        methodFilter == "" ? null : methodFilter,
        personFilter == "" ? null : personFilter,
        ratingFilter == 0 ? null : ratingFilter));

    protected override async Task OnInitializedAsync()
    {
        BrewStore.Changed += OnStoreChanged;
        await LoadAsync();
        _ = LoadMemberNamesAsync();
    }

    /// <summary>Names of the household's members, so their brews show "Bob" instead of an id. Best effort: offline or signed out keeps the ids.</summary>
    private async Task LoadMemberNamesAsync()
    {
        try
        {
            var household = await Households.GetAsync();
            memberNames = household.Members.ToDictionary(m => m.UserId, m => m.DisplayName);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception exception) when (exception is Dialed.Client.Account.AccountApiException or Dialed.Client.Account.AccountRefusedException or HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        {
            // Not signed in or offline: ids stay as they are.
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        compareWith = "";
        editing = false;
        confirmingDelete = false;
        error = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        brews = await BrewStore.ListAsync();
        bags = await BagStore.ListAsync();
        beans = [.. (await BeanStore.ListAsync()).OrderBy(b => b.Name)];
        gear = await GearStore.ListAsync();
        current = Id is null ? null : brews.FirstOrDefault(b => b.Id == Id);
        recipe = current?.RecipeId is { } recipeId ? await RecipeStore.GetAsync(recipeId) : null;
        comparison = current is null ? [] : BrewHistory.Compare(current, recipe);
    }

    private void OnStoreChanged() => _ = InvokeAsync(async () =>
    {
        if (editing)
        {
            return;
        }

        await LoadAsync();
        StateHasChanged();
    });

    private bool IsMine(Brew brew) => brew.CreatedBy == Context.UserId;

    private string PersonName(string userId) =>
        userId == Context.UserId ? L["History_You"].Value : memberNames.GetValueOrDefault(userId) ?? userId;

    /// <summary>Who brewed is only worth showing when more than one person brews here.</summary>
    private bool ShowsPeople => (brews ?? []).Select(b => b.CreatedBy).Distinct().Skip(1).Any();

    private int ActiveFilterCount =>
        (beanFilter == "" ? 0 : 1) + (methodFilter == "" ? 0 : 1) + (personFilter == "" ? 0 : 1) + (ratingFilter == 0 ? 0 : 1);

    private DateOnly Today => DateOnly.FromDateTime(Time.GetLocalNow().DateTime);

    private static DateOnly DayOf(Brew brew) => DateOnly.FromDateTime(brew.BrewedAt.ToLocalTime().DateTime);

    private IEnumerable<IGrouping<DateOnly, Brew>> Days => Visible.GroupBy(DayOf);

    private string DayTitle(DateOnly day) =>
        day == Today ? L["Day_Today"].Value
        : day == Today.AddDays(-1) ? L["Day_Yesterday"].Value
        : day.Year == Today.Year ? day.ToString("dddd d MMMM", CultureInfo.CurrentCulture)
        : day.ToString("d MMMM yyyy", CultureInfo.CurrentCulture);

    private string WhenText(DateTimeOffset at)
    {
        var local = at.ToLocalTime();
        return $"{DayTitle(DateOnly.FromDateTime(local.DateTime))}, {local.ToString("t", CultureInfo.CurrentCulture)}";
    }

    /// <summary>"Flat white · Espresso", or just "Espresso" when the drink and the method say the same.</summary>
    private string WhatText(Brew brew)
    {
        var drink = L[$"DrinkType_{brew.DrinkType}"].Value;
        var method = MethodName(brew.MethodCode);
        var what = string.Equals(drink, method, StringComparison.OrdinalIgnoreCase) || brew.DrinkType is DrinkType.Filter or DrinkType.Other
            ? method
            : $"{drink} · {method}";
        return what + MilkText(brew);
    }

    /// <summary>Only the parts of the taste that were off, as short words ("Sour 1").</summary>
    private IEnumerable<string> TasteNotes(Taste taste)
    {
        (int Value, string Low, string High)[] axes =
            [(taste.Acidity, "Taste_Sour", "Taste_Bitter"), (taste.Strength, "Taste_Weak", "Taste_Strong"), (taste.Body, "Taste_Thin", "Taste_Heavy"), (taste.Sweetness, "Taste_Flat", "Taste_Sweet")];
        return axes.Where(a => a.Value != 0).Select(a => $"{L[a.Value < 0 ? a.Low : a.High].Value} {Math.Abs(a.Value)}");
    }

    /// <summary>Makes the picture of this brew (bean, method, numbers, rating) and hands it to the share sheet or a download.</summary>
    /// <summary>What the coffee in this brew cost, from the price and weight of its bag.</summary>
    private string? CostText
    {
        get
        {
            var bag = current is null ? null : bags.FirstOrDefault(b => b.Id == current.BagId);
            return current is not null && bag is not null && CupCost.ForBrew(current, bag) is { } cents
                ? $"{(cents / 100m).ToString("N2", CultureInfo.CurrentCulture)} {(string.IsNullOrWhiteSpace(bag.Currency) ? "EUR" : bag.Currency.ToUpperInvariant())}"
                : null;
        }
    }

    private IReadOnlyList<Brew> Siblings => current is null ? [] : BrewHistory.SameBean(current, brews ?? [], bags);

    private string SiblingLabel(Brew brew) =>
        $"{WhenText(brew.BrewedAt)}{(brew.Rating is { } stars ? $" · {stars} ★" : "")}";

    private Task CompareAsync()
    {
        if (current is not null && compareWith != "")
        {
            Navigation.NavigateTo($"history/compare/{current.Id}/{compareWith}");
        }

        return Task.CompletedTask;
    }

    private async Task ShareCardAsync()
    {
        if (current is null || sharing)
        {
            return;
        }

        sharing = true;
        error = null;
        try
        {
            var bean = beans.FirstOrDefault(b => b.Id == bags.FirstOrDefault(g => g.Id == current.BagId)?.BeanId);
            var origin = bean is null ? null : string.Join(", ", new[] { bean.Origin.Country, bean.Origin.Region }.Where(p => !string.IsNullOrWhiteSpace(p)));
            var parameters = comparison.Where(r => r.Actual is not null).Select(r => (ParameterLabel(r.Parameter), Format(r.Parameter, r.Actual))).ToList();
            var svg = Dialed.UI.Cards.BrewCard.Build(new Dialed.UI.Cards.BrewCardContent(
                BeanOf(current),
                origin,
                current.Rating,
                MethodName(current.MethodCode),
                parameters,
                bean is { TastingNotes.Count: > 0 } ? string.Join(" · ", bean.TastingNotes) : current.Notes,
                string.Format(L["Card_Footer"].Value, current.BrewedAt.ToLocalTime().ToString("d MMM yyyy", CultureInfo.CurrentCulture)),
                bean?.RoastLevel));
            var png = await Images.SvgToPngAsync(svg, Dialed.UI.Cards.BrewCard.Width, Dialed.UI.Cards.BrewCard.Height);
            if (png is null)
            {
                error = L["Card_Failed"].Value;
                return;
            }

            await Files.SaveAsync("dialed-brew.png", "image/png", png);
        }
        finally
        {
            sharing = false;
        }
    }

    private static string MethodName(string code) => BrewMethodCatalog.Default.Find(code)?.Name ?? code;

    private string BeanOf(Brew brew)
    {
        var beanId = bags.FirstOrDefault(b => b.Id == brew.BagId)?.BeanId;
        return beans.FirstOrDefault(b => b.Id == beanId)?.Name ?? L["Bag_UnknownBean"].Value;
    }

    private string Subtitle(Brew brew)
    {
        var parts = new List<string> { brew.BrewedAt.ToLocalTime().ToString("t", CultureInfo.CurrentCulture), WhatText(brew) };
        parts.Add((brew.WaterG ?? brew.YieldG) is { } liquid ? $"{Units.Weight(brew.DoseG)} → {Units.Weight(liquid)}" : Units.Weight(brew.DoseG));
        return string.Join(" · ", parts);
    }

    private string MilkText(Brew brew) =>
        brew.MilkMl is { } ml
            ? " · " + string.Format(L["History_Milk"].Value, Units.System == Dialed.Domain.Units.UnitSystem.Imperial
                ? Dialed.Domain.Units.UnitFormatting.FormatVolume(ml, Units.System)
                : $"{ml} ml")
            : "";

    private string ParameterLabel(BrewParameter parameter) => parameter switch
    {
        BrewParameter.Dose => L["Recipe_Dose"].Value,
        BrewParameter.Water => L["Recipe_Water"].Value,
        BrewParameter.Yield => L["Recipe_Yield"].Value,
        BrewParameter.Grind => L["Recipe_Grind"].Value,
        BrewParameter.Temperature => L["Recipe_Temp"].Value,
        _ => L["History_Time"].Value,
    };

    private string Format(BrewParameter parameter, decimal? value)
    {
        if (value is not { } v)
        {
            return "–";
        }

        return parameter switch
        {
            BrewParameter.Dose or BrewParameter.Water or BrewParameter.Yield => Units.Weight(v),
            BrewParameter.Temperature => Units.Temperature(v),
            BrewParameter.Time => $"{v:0} s",
            _ => Dialed.Domain.Equipment.GrindScale.Format(v),
        };
    }

    private RenderFragment TasteFact(string labelKey, string lowKey, string highKey, int value) => __builder =>
    {
        <dt>@L[labelKey]</dt>
        <dd>@(value == 0 ? L["History_Balanced"].Value : value < 0 ? $"{L[lowKey]} {-value}" : $"{L[highKey]} {value}")</dd>
    };

    private async Task UpdateAsync(Brew brew)
    {
        try
        {
            await BrewStore.SaveAsync(brew);
            error = null;
        }
        catch (ConflictException)
        {
            error = L["Error_Conflict"];
        }

        editing = false;
        await LoadAsync();
    }

    private async Task DeleteAsync()
    {
        if (current is null || !IsMine(current))
        {
            return;
        }

        await BrewStore.DeleteAsync(current.Id);
        Navigation.NavigateTo("history");
    }

    public void Dispose() => BrewStore.Changed -= OnStoreChanged;
}
