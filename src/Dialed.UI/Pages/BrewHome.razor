@page "/brew"
@page "/brew/{BagId}"
@using Dialed.Client.Data
@using Dialed.Client.Preferences
@using Dialed.Domain.BrewMethods
@using Dialed.Domain.DialIn
@using Dialed.Domain.Inventory
@using Dialed.Domain.Model
@implements IDisposable
@inject IStringLocalizer<Strings> L
@inject IRepository<Bag> BagStore
@inject IRepository<Bean> BeanStore
@inject IRepository<Recipe> RecipeStore
@inject IRepository<Brew> BrewStore
@inject IRepository<EquipmentItem> GearStore
@inject UnitFormatter Units
@inject IUserPreferences Preferences
@inject TimeProvider Time

<ListDetailLayout HasSelection="@(BagId is not null)">
    <List>
        <PageHeader Title="@L["Nav_Brew"]" />

        @if (bags is null)
        {
            <Loading IsLoading="true" />
        }
        else if (Active.Count == 0)
        {
            <EmptyState Icon="@(new Icons.Regular.Size24.Box())" Message="@L["Brew_NoBags"]">
                <a class="dialed-button dialed-button-primary" href="bags/new">@L["Bags_New"]</a>
            </EmptyState>
        }
        else
        {
            <p class="dialed-muted">@L["Brew_PickBag"]</p>
            <div class="dialed-list" id="brew-bags">
                @foreach (var item in Active)
                {
                    <ListRow Title="@Name(item)" Subtitle="@PickSubtitle(item)" Href="@($"brew/{item.Bag.Id}")" data-bag="@item.Bag.Id">
                        <Leading><Thumb PhotoId="@PhotoOf(item.Bag.BeanId)" Size="48" /></Leading>
                        <Trailing>
                            @if (item.Bag.Status == BagStatus.Sealed)
                            {
                                <Chip>@L["BagStatus_Sealed"]</Chip>
                            }
                            else if (item.Freshness != Freshness.Unknown)
                            {
                                <Chip>@L[$"Fresh_{item.Freshness}"]</Chip>
                            }
                        </Trailing>
                    </ListRow>
                }
            </div>
        }
    </List>
    <Detail>
        @if (BagId is null)
        {
            <EmptyState Icon="@(new Icons.Regular.Size24.DrinkCoffee())" Message="@L["Brew_SelectPrompt"]" />
        }
        else if (current is null)
        {
            <PageHeader Title="@L["Nav_Brew"]" BackHref="brew" />
            <EmptyState Message="@L["Bags_NotFound"]" />
        }
        else
        {
            <PageHeader Title="@BeanName(current.BeanId)" BackHref="brew" />

            @if (currentStock is not null)
            {
                <Card class="dialed-card dialed-brew-bag" id="brew-bag-summary">
                    <div class="dialed-brew-bag-top">
                        <Thumb PhotoId="@PhotoOf(current.BeanId)" Size="72" />
                        <div class="dialed-stat-grid">
                            <StatTile Value="@Units.Weight(currentStock.RemainingG)" Label="@L["Bag_Remaining"]" Hint="@string.Format(L["Brew_OfWeight"].Value, Units.Weight(current.WeightG))" />
                            @if (currentStock.AgeDays is { } age)
                            {
                                <StatTile Value="@string.Format(L["Brew_Days"].Value, age)" Label="@L["Brew_SinceRoast"]" Hint="@(currentStock.Freshness == Freshness.Unknown ? null : L[$"Fresh_{currentStock.Freshness}"].Value)" />
                            }
                        </div>
                    </div>
                    <Meter Label="@L["Bag_Remaining"]" Fraction="@(current.WeightG > 0 ? (double)(currentStock.RemainingG / current.WeightG) : 0)"
                           Tone="@(currentStock.IsLow ? Meter.MeterTone.Warning : Meter.MeterTone.Normal)"
                           ValueText="@string.Format(L["Home_LeftOf"].Value, Units.Weight(currentStock.RemainingG), Units.Weight(current.WeightG))" />
                </Card>
            }

            @if (logged is not null)
            {
                <DialInAdviceCard Brew="logged" Scale="@loggedScale" />
            }

            @if (last is not null)
            {
                <a id="brew-again" class="dialed-card dialed-card-link dialed-brew-again" href="@($"brew/{current.Id}/log/again/{last.Id}")">
                    <MethodIcon Code="@last.MethodCode" />
                    <span class="dialed-row-text">
                        <span class="dialed-row-title">@L["Brew_Again"]</span>
                        <span class="dialed-row-subtitle">@Describe(last)</span>
                    </span>
                    <span class="dialed-row-chevron" aria-hidden="true"><FluentIcon Value="@(new Icons.Regular.Size24.ChevronRight())" Color="Color.Custom" CustomColor="currentColor" /></span>
                </a>
            }

            <SectionHeader Title="@L["Brew_WithRecipe"]" />
            @if (recipesForBag.Count == 0)
            {
                <p class="dialed-muted">@L["Brew_NoRecipes"]</p>
            }
            else
            {
                <div class="dialed-list">
                    @foreach (var recipe in recipesForBag)
                    {
                        <div class="dialed-recipe-choice">
                            <ListRow Title="@recipe.Name" Subtitle="@RecipeSummary(recipe)" Href="@($"brew/{current.Id}/log/recipe/{recipe.Id}")">
                                <Leading><MethodIcon Code="@recipe.MethodCode" /></Leading>
                            </ListRow>
                            <a class="dialed-button dialed-button-icon" href="@($"brew/{current.Id}/timer/{recipe.Id}")" aria-label="@string.Format(L["Timer_StartFor"].Value, recipe.Name)">
                                <span class="dialed-button-glyph" aria-hidden="true"><FluentIcon Value="@(new Icons.Regular.Size24.Timer())" Color="Color.Custom" CustomColor="currentColor" /></span>
                                @L["Timer_Start"]
                            </a>
                        </div>
                    }
                </div>
            }

            <div class="dialed-form-actions">
                <a id="brew-blank" class="dialed-button" href="@($"brew/{current.Id}/log")">@L["Brew_WithoutRecipe"]</a>
            </div>
        }
    </Detail>
</ListDetailLayout>

@code {
    private IReadOnlyList<Bag>? bags;
    private IReadOnlyList<BagStock> stock = [];
    private BagStock? currentStock;
    private IReadOnlyList<Bean> beans = [];
    private IReadOnlyList<Brew> brews = [];
    private IReadOnlyList<Recipe> recipes = [];
    private Bag? current;
    private Brew? last;
    private IReadOnlyList<Recipe> recipesForBag = [];

    [Parameter]
    public string? BagId { get; set; }

    /// <summary>The brew just logged from this bag: when it did not taste right, its dial-in advice shows at the top (#86).</summary>
    [SupplyParameterFromQuery(Name = "logged")]
    public string? Logged { get; set; }

    private Brew? logged;
    private Dialed.Domain.Equipment.GrindScale? loggedScale;

    /// <summary>Open bags first (what you are brewing from), then sealed ones; frozen and finished bags are not offered.</summary>
    private IReadOnlyList<BagStock> Active =>
        [.. stock.Where(s => s.Bag.Status is BagStatus.Open or BagStatus.Sealed)
            .OrderBy(s => s.Bag.Status == BagStatus.Open ? 0 : 1)
            .ThenBy(s => Name(s), StringComparer.OrdinalIgnoreCase)];

    protected override async Task OnInitializedAsync()
    {
        BagStore.Changed += OnStoreChanged;
        BrewStore.Changed += OnStoreChanged;
        RecipeStore.Changed += OnStoreChanged;
        BeanStore.Changed += OnStoreChanged;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        bags = await BagStore.ListAsync();
        beans = await BeanStore.ListAsync();
        brews = await BrewStore.ListAsync();
        recipes = await RecipeStore.ListAsync();
        stock = InventoryOverview.Build(bags, beans, brews, DateOnly.FromDateTime(Time.GetLocalNow().DateTime), Preferences.Inventory);
        current = BagId is null ? null : bags.FirstOrDefault(b => b.Id == BagId);
        currentStock = current is null ? null : stock.FirstOrDefault(s => s.Bag.Id == current.Id);
        last = current is null ? null : BrewPrefill.Last(current.Id, brews);
        logged = current is null || Logged is null ? null : brews.FirstOrDefault(b => !b.Deleted && b.Id == Logged && b.BagId == current.Id && DialInHistory.NeedsAdvice(b));
        loggedScale = logged?.GrinderId is { } grinderId ? (await GearStore.GetAsync(grinderId))?.GrindScale : null;
        recipesForBag = current is null
            ? []
            : [.. recipes.Where(r => !r.IsSuperseded && (r.BeanId == current.BeanId || r.BeanId is null))
                .OrderByDescending(r => r.BeanId == current.BeanId)
                .ThenBy(r => r.Name, StringComparer.OrdinalIgnoreCase)];
    }

    private void OnStoreChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    private string BeanName(string beanId) => beans.FirstOrDefault(b => b.Id == beanId)?.Name ?? L["Bag_UnknownBean"].Value;

    private static string MethodName(string code) => BrewMethodCatalog.Default.Find(code)?.Name ?? code;

    private string Name(BagStock item) => item.BeanName.Length > 0 ? item.BeanName : L["Bag_UnknownBean"].Value;

    private string? PhotoOf(string beanId) => beans.FirstOrDefault(b => b.Id == beanId)?.PhotoIds.FirstOrDefault();

    private string PickSubtitle(BagStock item)
    {
        var parts = new List<string> { string.Format(L["Brew_Left"].Value, Units.Weight(item.RemainingG)) };
        if (item.AgeDays is { } age)
        {
            parts.Add(string.Format(L["Stock_DaysSinceRoast"].Value, age));
        }

        return string.Join(" · ", parts);
    }

    private string RecipeSummary(Recipe recipe)
    {
        var parts = new List<string> { MethodName(recipe.MethodCode) };
        if (recipe.DoseG is { } dose)
        {
            parts.Add((recipe.WaterG ?? recipe.YieldG) is { } liquid ? $"{Units.Weight(dose)} → {Units.Weight(liquid)}" : Units.Weight(dose));
        }

        return string.Join(" · ", parts);
    }

    private string Describe(Brew brew)
    {
        var amounts = (brew.WaterG ?? brew.YieldG) is { } liquid ? $"{Units.Weight(brew.DoseG)} → {Units.Weight(liquid)}" : Units.Weight(brew.DoseG);
        return $"{amounts} · {MethodName(brew.MethodCode)}";
    }

    public void Dispose()
    {
        BagStore.Changed -= OnStoreChanged;
        BrewStore.Changed -= OnStoreChanged;
        RecipeStore.Changed -= OnStoreChanged;
        BeanStore.Changed -= OnStoreChanged;
    }
}
