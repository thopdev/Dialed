@page "/brew/{BagId}/timer/{RecipeId}"
@using Dialed.Client
@using Dialed.Client.Data
@using Dialed.Client.Platform
@using Dialed.Client.Preferences
@using Dialed.Domain.BrewMethods
@using Dialed.Domain.Model
@implements IAsyncDisposable
@inject IStringLocalizer<Strings> L
@inject IRepository<Recipe> RecipeStore
@inject IWakeLock WakeLock
@inject ISoundCue Sound
@inject ISpeechCue Speech
@inject IUserPreferences Preferences
@inject BrewTimerHandoff Handoff
@inject UnitFormatter Units
@inject NavigationManager Navigation
@inject TimeProvider Time

@if (loading)
{
    <Loading IsLoading="true" />
}
else if (recipe is null)
{
    <PageHeader Title="@L["Nav_Recipes"]" BackHref="@($"brew/{BagId}")" />
    <EmptyState Message="@L["Recipes_NotFound"]" />
}
else
{
    <div class="dialed-timer @StatusClass @(focus ? "dialed-timer-focus" : "")" data-mode="@(isEspresso ? "espresso" : "guided")" data-step-key="@stepKey">
        <PageHeader Title="@recipe.Name" BackHref="@($"brew/{BagId}")" />

        <div id="timer-clock" class="dialed-timer-clock" role="timer" aria-label="@L["Timer_Elapsed"]">@Clock(elapsed)</div>

        @if (ProgressTotal is { } total and > 0)
        {
            <Meter id="timer-progress" Label="@L["Timer_Progress"]" Fraction="@((double)elapsed / total)"
                   Tone="@(isEspresso && running && band.StatusAt(elapsed) == ShotStatus.TooLong ? Meter.MeterTone.Danger : Meter.MeterTone.Normal)"
                   ValueText="@string.Format(L["Timer_ProgressValue"].Value, Clock(elapsed), Clock(total))" />
        }

        @if (!isEspresso && timeline.Steps.Count > 0)
        {
            <PourFigure Id="timer-figure" Fraction="@FigureFraction" Pattern="state.Current?.Pattern" Pouring="@(running && !paused && !state.IsFinished && state.Current is { Kind: RecipeStepKind.Bloom or RecipeStepKind.Pour })"
                        Animated="@(running && !paused)" Cylinder="@(recipe.MethodCode is "aeropress" or "french-press")" />
        }

        @if (isEspresso)
        {
            <p id="timer-band" class="dialed-timer-sub">@string.Format(L["Timer_Band"].Value, band.LowerS, band.UpperS)</p>
            @if (running)
            {
                <p id="timer-shot-status" class="dialed-timer-step">@L[$"Shot_{band.StatusAt(elapsed)}"]</p>
            }
        }
        else
        {
            @if (state.Current is { } step)
            {
                <p id="timer-step" class="dialed-timer-step" @key="stepKey">@L[$"StepKind_{step.Kind}"]@(string.IsNullOrWhiteSpace(step.Note) ? "" : " · " + step.Note)</p>
            }
            else if (running)
            {
                <p id="timer-step" class="dialed-timer-step" @key="stepKey">@L["Timer_GetReady"]</p>
            }

            @if (state.TargetWaterG is { } target)
            {
                <p id="timer-target" class="dialed-timer-target">@string.Format(L["Timer_Target"].Value, Units.Weight(target))</p>
                @if (AddWater is { } add)
                {
                    <p id="timer-add" class="dialed-timer-sub">@string.Format(L["Timer_Add"].Value, Units.Weight(add))</p>
                }
            }

            @if (state.IsFinished)
            {
                <p id="timer-done" class="dialed-timer-step">@L["Timer_Done"]</p>
            }
            else if (state.Next is { } next)
            {
                <p id="timer-next" class="dialed-timer-sub">
                    @string.Format(L["Timer_Next"].Value, L[$"StepKind_{next.Kind}"].Value, Clock(state.SecondsToNext ?? 0))
                    @if (next.WaterG is { } nextWater)
                    {
                        <span> · @string.Format(L["Timer_Target"].Value, Units.Weight(nextWater))</span>
                    }
                </p>
            }
        }

        @if (!isEspresso && timeline.Steps.Count > 0)
        {
            <ol id="timer-steps" class="dialed-timer-steps" aria-label="@L["Recipe_Steps"]">
                @for (var i = 0; i < timeline.Steps.Count; i++)
                {
                    var step = timeline.Steps[i];
                    var stepState = i < state.CurrentIndex || (state.IsFinished && running) ? "done" : i == state.CurrentIndex && running ? "current" : "";
                    <li class="dialed-timer-step-item @stepState" aria-current="@(stepState == "current" ? "step" : null)">
                        <span class="dialed-timer-step-at">@Clock(step.AtS)</span>
                        <span class="dialed-timer-step-kind">@L[$"StepKind_{step.Kind}"]</span>
                        @if (step.WaterG is { } water)
                        {
                            <span class="dialed-timer-step-water">@string.Format(L["Timer_Target"].Value, Units.Weight(water))</span>
                        }
                    </li>
                }
            </ol>
        }

        @if (speechSupported && !isEspresso)
        {
            <label class="dialed-check dialed-timer-voice"><input id="timer-voice" type="checkbox" checked="@Preferences.Profile.TimerVoice" @onchange="e => SetVoiceAsync((bool)e.Value!)" /> @L["Timer_Voice"]</label>
        }

        @* Controls like a music player: round icon buttons, a big play/pause in the middle. *@
        <div class="dialed-transport" role="group" aria-label="@L["Timer_Controls"]">
            <button type="button" id="timer-focus" class="dialed-transport-button" aria-label="@L[focus ? "Timer_FocusOff" : "Timer_FocusOn"]" title="@L[focus ? "Timer_FocusOff" : "Timer_FocusOn"]" aria-pressed="@(focus ? "true" : "false")" @onclick="@(() => focus = !focus)">
                <FluentIcon Value="@FocusIcon" Color="Color.Custom" CustomColor="currentColor" />
            </button>

            @if (running || elapsed > 0)
            {
                <button type="button" id="timer-reset" class="dialed-transport-button" aria-label="@L["Timer_Reset"]" title="@L["Timer_Reset"]" @onclick="ResetAsync">
                    <FluentIcon Value="@(new Icons.Regular.Size24.ArrowCounterclockwise())" Color="Color.Custom" CustomColor="currentColor" />
                </button>
            }

            @if (!running)
            {
                <button type="button" id="timer-start" class="dialed-transport-button dialed-transport-main" aria-label="@L["Timer_StartButton"]" title="@L["Timer_StartButton"]" @onclick="StartAsync">
                    <FluentIcon Value="@(new Icons.Filled.Size32.Play())" Color="Color.Custom" CustomColor="currentColor" />
                </button>
            }
            else if (isEspresso)
            {
                <button type="button" id="timer-finish" class="dialed-transport-button dialed-transport-main" aria-label="@L["Timer_Finish"]" title="@L["Timer_Finish"]" @onclick="FinishAsync">
                    <FluentIcon Value="@(new Icons.Filled.Size24.Stop())" Color="Color.Custom" CustomColor="currentColor" />
                </button>
            }
            else
            {
                <button type="button" id="timer-pause" class="dialed-transport-button dialed-transport-main" aria-label="@L[paused ? "Timer_Resume" : "Timer_Pause"]" title="@L[paused ? "Timer_Resume" : "Timer_Pause"]" aria-pressed="@(paused ? "true" : "false")" @onclick="TogglePauseAsync">
                    <FluentIcon Value="@PlayPauseIcon" Color="Color.Custom" CustomColor="currentColor" />
                </button>
                <button type="button" id="timer-finish" class="dialed-transport-button" aria-label="@L["Timer_Finish"]" title="@L["Timer_Finish"]" @onclick="FinishAsync">
                    <FluentIcon Value="@(new Icons.Regular.Size24.Checkmark())" Color="Color.Custom" CustomColor="currentColor" />
                </button>
            }
        </div>
    </div>
}

@code {
    private bool loading = true;
    private Recipe? recipe;
    private BrewTimeline timeline = new([]);
    private ShotBand band = ShotBand.Default;
    private bool isEspresso;
    private bool running;
    private int elapsed;
    private int stepKey;
    private bool doneCued;
    private bool speechSupported;
    private int lastCountdown;
    private bool paused;

    private Icon FocusIcon => focus ? new Icons.Regular.Size24.FullScreenMinimize() : new Icons.Regular.Size24.FullScreenMaximize();

    private Icon PlayPauseIcon => paused ? new Icons.Filled.Size32.Play() : new Icons.Filled.Size32.Pause();
    private bool focus;
    private DateTimeOffset pausedAt;

    /// <summary>Water to add in the current step (its target minus the target before it), shown beside the target.</summary>
    private decimal? AddWater
    {
        get
        {
            if (state.TargetWaterG is not { } target || state.Current is null)
            {
                return null;
            }

            var before = state.CurrentIndex > 0 ? timeline.Steps[state.CurrentIndex - 1].WaterG ?? 0m : 0m;
            return target - before is > 0m and var add ? add : null;
        }
    }

    /// <summary>Water so far over the recipe's total water: how full the drawing is.</summary>
    private double FigureFraction => running && recipe?.WaterG is > 0 && state.TargetWaterG is { } water ? (double)(water / recipe.WaterG.Value) : 0;
    private DateTimeOffset startedAt;
    private TimerState state = new BrewTimeline([]).At(0);
    private CancellationTokenSource? loop;

    [Parameter]
    public string BagId { get; set; } = "";

    [Parameter]
    public string RecipeId { get; set; } = "";

    private string StatusClass =>
        isEspresso && running ? $"shot-{band.StatusAt(elapsed).ToString().ToLowerInvariant()}" : state.IsFinished ? "finished" : "";

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        speechSupported = await SafeAsync(() => Speech.IsSupportedAsync());
        await StopLoopAsync(releaseWakeLock: true);
        running = false;
        elapsed = 0;
        recipe = await RecipeStore.GetAsync(RecipeId);
        if (recipe is not null)
        {
            timeline = BrewTimeline.For(recipe);
            band = ShotBand.For(recipe);
            // Espresso (or anything without steps) gets the simple shot timer; steps drive the guided timer.
            isEspresso = recipe.Steps.Count == 0;
            state = timeline.At(0);
        }

        loading = false;
    }

    /// <summary>What the progress bar fills towards: the recipe's total time, or the top of the shot band for espresso.</summary>
    private int? ProgressTotal => isEspresso ? band.UpperS : timeline.TotalS;

    private static string Clock(int seconds) => $"{seconds / 60}:{seconds % 60:00}";

    private async Task StartAsync()
    {
        running = true;
        paused = false;
        doneCued = false;
        elapsed = 0;
        stepKey = 0;
        state = timeline.At(0);
        startedAt = Time.GetUtcNow();

        // Both calls need to come from this tap: browsers only allow audio and wake locks after a user gesture.
        await SafeAsync(() => WakeLock.AcquireAsync());
        await SafeAsync(() => Sound.PlayAsync(SoundCue.Tick));
        lastCountdown = 0;
        if (!isEspresso && state.Current is { } first)
        {
            await SayAsync(StepPhrase(first));
        }

        loop = new CancellationTokenSource();
        _ = RunAsync(loop.Token);
    }

    private async Task RunAsync(CancellationToken token)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(250), Time);
            while (await timer.WaitForNextTickAsync(token))
            {
                await InvokeAsync(Refresh);
            }
        }
        catch (OperationCanceledException)
        {
            // Stopped on purpose.
        }
    }

    /// <summary>Reads the clock and updates what is shown; called by the tick loop (and by tests with a manual clock).</summary>
    public async Task Refresh()
    {
        if (!running || paused)
        {
            return;
        }

        var previous = elapsed;
        elapsed = Math.Max(0, (int)(Time.GetUtcNow() - startedAt).TotalSeconds);
        state = timeline.At(elapsed);

        if (!isEspresso && timeline.StepStartedBetween(previous, elapsed))
        {
            stepKey++;
            lastCountdown = 0;
            await SafeAsync(() => Sound.PlayAsync(SoundCue.Tick));
            if (state.Current is { } current)
            {
                await SayAsync(StepPhrase(current));
            }
        }
        else if (!isEspresso && state.SecondsToNext is >= 1 and <= 3 and var left && left != lastCountdown)
        {
            // Three, two, one: a tick for each of the last seconds before the next step.
            lastCountdown = left;
            await SafeAsync(() => Sound.PlayAsync(SoundCue.Tick));
        }

        if (!isEspresso && state.IsFinished && !doneCued)
        {
            doneCued = true;
            await SafeAsync(() => Sound.PlayAsync(SoundCue.Done));
            await SayAsync(L["Timer_SayDone"].Value);
        }

        StateHasChanged();
    }

    private async Task SetVoiceAsync(bool on)
    {
        await Preferences.SetProfileAsync(Preferences.Profile with { TimerVoice = on });
        if (on && running && state.Current is { } current)
        {
            // Called from this tap, so the browser lets the first phrase through.
            await SayAsync(StepPhrase(current));
        }
    }

    /// <summary>"Pour, to 150 grams" (or just "Bloom" without a target), in the language of the app.</summary>
    private string StepPhrase(RecipeStep step)
    {
        var name = L[$"StepKind_{step.Kind}"].Value;
        if (step.WaterG is not { } water)
        {
            return name;
        }

        // Said, not written: "150 grams", never "150 g".
        var number = Math.Round(Units.ToDisplayWeight(water), 1).ToString("0.#", System.Globalization.CultureInfo.CurrentCulture);
        var amount = string.Format(L[Units.System == Dialed.Domain.Units.UnitSystem.Metric ? "Timer_SayGrams" : "Timer_SayOunces"].Value, number);
        return string.Format(L["Timer_SayStep"].Value, name, amount);
    }

    private async Task SayAsync(string text)
    {
        if (speechSupported && Preferences.Profile.TimerVoice)
        {
            await SafeAsync(() => Speech.SpeakAsync(text, System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "nl" ? "nl" : "en"));
        }
    }

    private async Task FinishAsync()
    {
        await Refresh();
        var seconds = elapsed;
        await StopLoopAsync(releaseWakeLock: true);
        running = false;
        Handoff.Set(RecipeId, seconds);
        Navigation.NavigateTo($"brew/{BagId}/log/recipe/{RecipeId}?quick=1");
    }

    private Task TogglePauseAsync()
    {
        if (paused)
        {
            // The time spent paused does not count: move the start forward by it.
            startedAt += Time.GetUtcNow() - pausedAt;
            paused = false;
        }
        else
        {
            pausedAt = Time.GetUtcNow();
            paused = true;
        }

        return Task.CompletedTask;
    }

    private async Task ResetAsync()
    {
        await StopLoopAsync(releaseWakeLock: true);
        paused = false;
        running = false;
        elapsed = 0;
        stepKey = 0;
        state = timeline.At(0);
    }

    private async Task StopLoopAsync(bool releaseWakeLock)
    {
        if (loop is not null)
        {
            await loop.CancelAsync();
            loop.Dispose();
            loop = null;
        }

        if (releaseWakeLock)
        {
            await SafeAsync(() => WakeLock.ReleaseAsync());
        }
    }

    // The screen staying awake and the beep are comforts: a refusal or a JS error must never stop the timer.
    private static async Task SafeAsync(Func<Task> action)
    {
        try
        {
            await action();
        }
        catch (Exception)
        {
            // Ignored on purpose.
        }
    }

    private static async Task<bool> SafeAsync(Func<Task<bool>> action)
    {
        try
        {
            return await action();
        }
        catch (Exception)
        {
            return false;
        }
    }

    public async ValueTask DisposeAsync() => await StopLoopAsync(releaseWakeLock: true);
}
