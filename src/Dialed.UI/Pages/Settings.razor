@page "/settings"
@using System.Reflection
@using Dialed.Client
@using Dialed.Client.Storage
@inject IStringLocalizer<Strings> L
@inject StorageStatus Storage

<PageHeader Title="@L["Settings_Title"]" BackHref="more" />

<nav class="dialed-settings-jump" aria-label="@L["Settings_JumpTo"]">
    @foreach (var (id, key) in Groups)
    {
        <a class="dialed-chip" href="@($"settings#{id}")">@L[key]</a>
    }
</nav>

<SettingsGroup Id="group-profile" Title="@L["Settings_GroupProfile"]" Icon="@(new Icons.Regular.Size24.Person())">
    <div id="settings-profile">
        <ProfileForm />
    </div>
    <div id="settings-public-profile" class="dialed-settings-item">
        <PublicProfilePanel />
    </div>
</SettingsGroup>

<SettingsGroup Id="group-preferences" Title="@L["Settings_GroupPreferences"]" Icon="@(new Icons.Regular.Size24.Options())">
    <div id="settings-units" class="dialed-settings-item">
        <UnitsSetting />
    </div>
    <div id="settings-methods" class="dialed-settings-item">
        <FavouriteMethodsPicker />
    </div>
    <div id="settings-inventory" class="dialed-settings-item">
        <InventorySettingsForm />
    </div>
</SettingsGroup>

<SettingsGroup Id="group-household" Title="@L["Settings_GroupHousehold"]" Icon="@(new Icons.Regular.Size24.People())">
    <div id="settings-household">
        <HouseholdPanel />
    </div>
</SettingsGroup>

<SettingsGroup Id="group-data" Title="@L["Settings_GroupData"]" Icon="@(new Icons.Regular.Size24.Database())">
    <div id="settings-sync" class="dialed-settings-item">
        <h3>@L["More_Diagnostics"]</h3>
        <ApiStatus />
        <SyncDiagnostics />
    </div>
    <div id="settings-storage" class="dialed-settings-item">
        <h3>@L["Settings_Storage"]</h3>
        <p id="storage-status" class="dialed-muted">@L[Storage.Durable ? (Storage.Persisted ? "Storage_Persisted" : "Storage_Unprotected") : "Storage_Memory"]</p>
    </div>
</SettingsGroup>

<SettingsGroup Id="group-account" Title="@L["Settings_Account"]" Icon="@(new Icons.Regular.Size24.ShieldLock())">
    <div id="settings-account" class="dialed-settings-item">
        <AccountPanel />
    </div>
    <div id="settings-passkeys" class="dialed-settings-item">
        <PasskeysPanel />
    </div>
    <div class="dialed-settings-item">
        <DataControls />
    </div>
</SettingsGroup>

<SettingsGroup Id="group-privacy" Title="@L["Settings_GroupPrivacy"]" Icon="@(new Icons.Regular.Size24.LockClosed())">
    <div id="settings-privacy">
        <p><a id="privacy-link" class="dialed-inline-link" href="privacy">@L["Settings_PrivacyLink"]</a></p>
        <ErrorReportingSetting />
    </div>
</SettingsGroup>

<SettingsGroup Id="group-help" Title="@L["Settings_GroupHelp"]" Icon="@(new Icons.Regular.Size24.ChatHelp())">
    <div id="settings-feedback" class="dialed-settings-item">
        <h3>@L["Feedback_Title"]</h3>
        <FeedbackPanel />
    </div>
    <div id="settings-setup" class="dialed-settings-item">
        <h3>@L["Settings_Setup"]</h3>
        <a id="settings-reopen-onboarding" class="dialed-button" href="welcome">@L["Settings_ReopenSetup"]</a>
    </div>
    <InstallGuide />
</SettingsGroup>

<SettingsGroup Id="group-about" Title="@L["Settings_GroupAbout"]" Icon="@(new Icons.Regular.Size24.Info())">
    <p class="dialed-muted" id="settings-version">@string.Format(L["Settings_Version"].Value, Version)</p>
</SettingsGroup>

@code {
    private static readonly (string Id, string Key)[] Groups =
    [
        ("group-profile", "Settings_GroupProfile"),
        ("group-preferences", "Settings_GroupPreferences"),
        ("group-data", "Settings_GroupData"),
        ("group-account", "Settings_Account"),
        ("group-privacy", "Settings_GroupPrivacy"),
        ("group-about", "Settings_GroupAbout"),
    ];

    private static string Version =>
        typeof(Settings).Assembly.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion.Split('+')[0] ?? "dev";
}
