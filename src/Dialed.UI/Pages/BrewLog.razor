@page "/brew/{BagId}/log"
@page "/brew/{BagId}/log/recipe/{RecipeId}"
@page "/brew/{BagId}/log/again/{BrewId}"
@using Dialed.Client
@using Dialed.Client.Data
@using Dialed.Domain.BrewMethods
@using Dialed.Domain.DialIn
@using Dialed.Domain.Model
@inject IStringLocalizer<Strings> L
@inject IRepository<Bag> BagStore
@inject IRepository<Bean> BeanStore
@inject IRepository<Recipe> RecipeStore
@inject IRepository<Brew> BrewStore
@inject IRepository<EquipmentItem> GearStore
@inject IRepository<MethodDefault> DefaultStore
@inject IRepository<DialInFeedback> FeedbackStore
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject BrewTimerHandoff TimerHandoff

<PageHeader Title="@L["Brew_LogTitle"]" BackHref="@($"brew/{BagId}")" />

@if (loading)
{
    <Loading IsLoading="true" />
}
else if (initial is null)
{
    <EmptyState Message="@L["Bags_NotFound"]" />
}
else
{
    @if (beanName is not null)
    {
        <p class="dialed-muted">@beanName</p>
    }

    @if (appliedKind is { } kind)
    {
        <p id="brew-advice-applied" class="dialed-muted" role="status">@string.Format(L["DialIn_Applied"].Value, L[$"DialIn_Kind_{kind}"].Value)</p>
    }

    @if (QuickMode)
    {
        <section id="quick-log" class="dialed-quick-log" aria-labelledby="quick-log-title">
            <h2 id="quick-log-title" class="dialed-quick-log-title">@L["QuickLog_Title"]</h2>
            <div id="quick-log-summary" class="dialed-quick-summary">
                <span class="dialed-quick-summary-title">@QuickSummaryTitle</span>
                <span class="dialed-muted">@QuickSummaryDetail</span>
            </div>
            <div class="dialed-quick-rating">
                <StarRating @bind-Value="quickRating" />
                <p id="quick-rating-word" class="dialed-quick-rating-word" aria-live="polite">@(quickRating > 0 ? L[$"QuickLog_Rating{quickRating}"].Value : L["QuickLog_RatingPrompt"].Value)</p>
            </div>
            <h3 class="dialed-quick-subtitle">@L["QuickLog_Stood"]</h3>
            <div class="dialed-quick-taste" role="group" aria-label="@L["Brew_Taste"]">
                @foreach (var axis in QuickAxes)
                {
                    var current = axis.Get();
                    <div class="dialed-quick-pair" data-axis="@axis.Id">
                        <Chip Selected="@(current < 0)" OnClick="@(() => Toggle(axis, -1))">@L[axis.Low]</Chip>
                        <Chip Selected="@(current > 0)" OnClick="@(() => Toggle(axis, 1))">@L[axis.High]</Chip>
                    </div>
                }
            </div>
            <div class="dialed-form-actions dialed-sticky-actions">
                <button id="quick-log-more" type="button" class="dialed-button" @onclick="ShowAll">@L["QuickLog_More"]</button>
                <button id="quick-log-save" type="button" class="dialed-button dialed-button-primary" @onclick="QuickSaveAsync">@L["Save"]</button>
            </div>
        </section>
    }
    else
    {
        <BrewForm Initial="initial" Gear="gear" OnSubmit="SaveAsync" OnCancel="@(() => Navigation.NavigateTo($"brew/{BagId}"))" />
    }
}

@code {
    private bool loading = true;
    private Brew? initial;
    private IReadOnlyList<EquipmentItem> gear = [];
    private string? beanName;

    [Parameter]
    public string BagId { get; set; } = "";

    [Parameter]
    public string? RecipeId { get; set; }

    [Parameter]
    public string? BrewId { get; set; }

    /// <summary>
    /// <c>primary</c> or <c>secondary</c>: which rules suggestion of the earlier brew to put into this one; <c>ai</c>: the assistant's change
    /// given by <see cref="ApplyKind"/> and <see cref="ApplyTo"/> (#86).
    /// </summary>
    [SupplyParameterFromQuery(Name = "apply")]
    public string? Apply { get; set; }

    [SupplyParameterFromQuery(Name = "kind")]
    public string? ApplyKind { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public string? ApplyTo { get; set; }

    private SuggestionKind? appliedKind;

    /// <summary>A finished timer opens the log in its short form: just the rating and how it tasted. "More details" shows the whole form.</summary>
    [SupplyParameterFromQuery(Name = "quick")]
    public string? Quick { get; set; }

    private bool showAll;
    private int quickRating;
    private int acidity;
    private int strength;
    private int body;
    private int sweetness;

    private string QuickSummaryTitle => BrewMethodCatalog.Default.Find(initial!.MethodCode)?.Name ?? initial.MethodCode;

    private string QuickSummaryDetail
    {
        get
        {
            var parts = new List<string> { initial!.WaterG is { } water ? $"{initial.DoseG:0.#} g → {water:0.#} g" : $"{initial.DoseG:0.#} g" };
            if (initial.TimeS is { } seconds and > 0)
            {
                parts.Add($"{seconds / 60}:{seconds % 60:00}");
            }

            return string.Join(" · ", parts);
        }
    }

    private bool QuickMode => !showAll && Quick == "1" && initial is { DoseG: > 0m };

    private sealed record QuickAxis(string Id, string Low, string High, Func<int> Get, Action<int> Set);

    private IReadOnlyList<QuickAxis> QuickAxes =>
    [
        new("acidity", "Taste_Sour", "Taste_Bitter", () => acidity, v => acidity = v),
        new("strength", "Taste_Weak", "Taste_Strong", () => strength, v => strength = v),
        new("body", "Taste_Thin", "Taste_Heavy", () => body, v => body = v),
        new("sweetness", "Taste_Flat", "Taste_Sweet", () => sweetness, v => sweetness = v),
    ];

    /// <summary>Tapping the chip that is on turns it off; tapping the other one of the pair switches sides.</summary>
    private static void Toggle(QuickAxis axis, int side) => axis.Set(axis.Get() == side ? 0 : side);

    private Brew WithQuickAnswers(Brew brew) => brew with
    {
        Rating = quickRating > 0 ? quickRating : null,
        Taste = new Taste(acidity, strength, body, sweetness),
    };

    private Task QuickSaveAsync() => SaveAsync(WithQuickAnswers(initial!));

    private void ShowAll()
    {
        initial = WithQuickAnswers(initial!);
        showAll = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        var bag = await BagStore.GetAsync(BagId);
        gear = await GearStore.ListAsync();
        if (bag is null)
        {
            initial = null;
            loading = false;
            return;
        }

        beanName = (await BeanStore.GetAsync(bag.BeanId))?.Name;
        var now = Time.GetUtcNow();
        if (RecipeId is not null && await RecipeStore.GetAsync(RecipeId) is { } recipe)
        {
            initial = BrewPrefill.FromRecipe(bag, recipe, now);
        }
        else if (BrewId is not null && await BrewStore.GetAsync(BrewId) is { } previous)
        {
            initial = BrewPrefill.Again(bag, previous, now);
            appliedKind = null;
            if (Apply is "primary" or "secondary" && BrewMethodCatalog.Default.Find(previous.MethodCode) is { } method)
            {
                var scale = gear.FirstOrDefault(g => g.Id == previous.GrinderId)?.GrindScale;
                var advice = DialInAdvisor.Advise(method, previous, scale);
                if ((Apply == "primary" ? advice.Primary : advice.Secondary) is { } suggestion && DialInApply.CanApply(suggestion))
                {
                    initial = DialInApply.Apply(initial, method, suggestion);
                    appliedKind = suggestion.Kind;
                }
            }
            else if (Apply == "ai" && BrewMethodCatalog.Default.Find(previous.MethodCode) is { } aiMethod
                && Enum.TryParse<SuggestionKind>(ApplyKind, out var kind) && Enum.IsDefined(kind)
                && decimal.TryParse(ApplyTo, System.Globalization.NumberStyles.Number, System.Globalization.CultureInfo.InvariantCulture, out var to) && to > 0m)
            {
                var suggestion = new DialInSuggestion(kind, SuggestionReason.Balanced, null, to);
                if (DialInApply.CanApply(suggestion))
                {
                    initial = DialInApply.Apply(initial, aiMethod, suggestion);
                    appliedKind = kind;
                }
            }
        }
        else
        {
            var defaults = await DefaultStore.ListAsync();
            var method = Dialed.Domain.BrewMethods.BrewMethodCatalog.Default.Methods[0].Code;
            initial = BrewPrefill.Blank(bag, method, defaults.FirstOrDefault(d => d.MethodCode == method)?.GrinderId, now);
        }

        // A finished timer run fills in the measured time (once).
        if (BrewId is null && TimerHandoff.Take(RecipeId) is { } measured)
        {
            initial = initial with { TimeS = measured };
        }

        loading = false;
    }

    private async Task SaveAsync(Brew brew)
    {
        var saved = await BrewStore.SaveAsync(brew with { BrewedAt = Time.GetUtcNow() });
        await LinkAppliedSuggestionAsync(saved);

        // A brew that did not taste right lands on the bag page with its dial-in advice (#86).
        Navigation.NavigateTo(DialInHistory.NeedsAdvice(saved) ? $"brew/{BagId}?logged={saved.Id}" : $"brew/{BagId}");
    }

    /// <summary>
    /// When this brew was started from "Apply to next brew", remembers which brew followed the suggestion and how it was rated, so the
    /// rating change after an accepted suggestion can be measured per prompt version (#89).
    /// </summary>
    private async Task LinkAppliedSuggestionAsync(Brew saved)
    {
        if (appliedKind is null || BrewId is null)
        {
            return;
        }

        var open = (await FeedbackStore.ListAsync())
            .Where(f => !f.Deleted && f.BrewId == BrewId && f.Outcome == DialInOutcome.Applied && f.NextBrewId is null)
            .OrderByDescending(f => f.CreatedAt)
            .FirstOrDefault();
        if (open is not null)
        {
            await FeedbackStore.SaveAsync(open with { NextBrewId = saved.Id, RatingAfter = saved.Rating });
        }
    }
}
