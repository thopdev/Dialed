@inherits LayoutComponentBase
@inject IStringLocalizer<Strings> L

@*
    One layout for every width, switched by CSS (wwwroot/css/shell.css):
    - narrow (iPhone, iPad split view up to ~half screen): content + bottom tab bar
    - wide (iPad full screen or two-thirds split, desktop): sidebar + content
*@
<FluentProviders />

<div class="dialed-shell">
    <aside class="dialed-sidebar">
        <div class="dialed-sidebar-brand">@L["App_Name"]</div>
        <SideNav />
    </aside>

    <main class="dialed-content">
        <UpdateBanner />
        <StorageWarning />
        <SyncIndicator />
        <PendingScansNote />
        <HouseholdPicker Id="household-picker-header" />
        <ReportingErrorBoundary @ref="errorBoundary">
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="exception">
                <ErrorPanel OnRetry="Recover" />
            </ErrorContent>
        </ReportingErrorBoundary>
    </main>

    <TabBar />
</div>

@code {
    private ReportingErrorBoundary? errorBoundary;

    // Navigating away from a broken screen should show the next one, not the error again.
    protected override void OnParametersSet() => errorBoundary?.Recover();

    private void Recover() => errorBoundary?.Recover();
}
