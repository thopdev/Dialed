@using Dialed.Client.Account
@using Dialed.Client.Households
@implements IDisposable
@inject HouseholdManager Households
@inject AuthSession Session
@inject Dialed.Client.Platform.IShareService Share
@inject NavigationManager Navigation
@inject IStringLocalizer<Strings> L

@* Who is in the household, invite codes, joining, leaving and removing, and creating, renaming and deleting households. Needs an account. *@
<div id="household-panel">
    <HouseholdPicker Id="household-picker-settings" />
    @if (!Session.IsSignedIn)
    {
        <p id="household-signin-hint" class="dialed-muted">@L["Household_SignInFirst"]</p>
    }
    else if (household is null)
    {
        <p class="dialed-muted">@(failed ? L["Household_LoadFailed"] : L["Household_Loading"])</p>
        @if (failed)
        {
            <button id="household-retry" type="button" class="dialed-button" @onclick="LoadAsync">@L["Error_Retry"]</button>
        }
    }
    else
    {
        @if (renaming)
        {
            <form class="dialed-form" id="household-rename-form" @onsubmit="RenameAsync" @onsubmit:preventDefault>
                <div class="dialed-field">
                    <label for="household-rename-input">@L["Household_Name"]</label>
                    <input id="household-rename-input" type="text" maxlength="@MaxNameLength" autocomplete="off" @bind="newName" @bind:event="oninput" />
                </div>
                <div class="dialed-form-actions">
                    <button id="household-rename-save" type="submit" class="dialed-button dialed-button-primary" disabled="@(busy || string.IsNullOrWhiteSpace(newName))">@L["Save"]</button>
                    <button id="household-rename-cancel" type="button" class="dialed-button" @onclick="() => renaming = false">@L["Cancel"]</button>
                </div>
            </form>
        }
        else
        {
            <div class="household-heading">
                <h3 id="household-name">@household.Name</h3>
                @if (household.YouAreOwner)
                {
                    <button id="household-rename" type="button" class="dialed-button dialed-button-subtle" aria-label="@string.Format(L["Household_RenameNamed"].Value, household.Name)" @onclick="StartRename">@L["Household_Rename"]</button>
                }
            </div>
        }
        <ul id="household-members" class="dialed-list">
            @foreach (var member in household.Members)
            {
                <li class="household-member" data-user="@member.UserId">
                    <span>@member.DisplayName@(member.IsOwner ? " · " + L["Household_Owner"].Value : "")</span>
                    @if (household.YouAreOwner && !member.IsOwner)
                    {
                        @if (transferring == member.UserId)
                        {
                            <button type="button" class="dialed-button household-transfer-confirm" disabled="@busy" @onclick="() => TransferAsync(member.UserId)">@L["Household_ConfirmTransfer"]</button>
                            <button type="button" class="dialed-button" @onclick="() => transferring = null">@L["Cancel"]</button>
                        }
                        else if (removing == member.UserId)
                        {
                            <button type="button" class="dialed-button household-remove-confirm" disabled="@busy" @onclick="() => RemoveAsync(member.UserId)">@L["Household_ConfirmRemove"]</button>
                        }
                        else
                        {
                            <button type="button" class="dialed-button household-transfer" @onclick="() => { transferring = member.UserId; removing = null; }">@L["Household_Transfer"]</button>
                            <button type="button" class="dialed-button household-remove" @onclick="() => { removing = member.UserId; transferring = null; }">@L["Household_Remove"]</button>
                        }
                    }
                </li>
            }
        </ul>

        @if (household.YouAreOwner)
        {
            <div class="dialed-field">
                <label for="household-invite-uses">@L["Household_InviteUses"]</label>
                <select id="household-invite-uses" @bind="maxUses">
                    @foreach (var option in UseOptions)
                    {
                        <option value="@option">@(option == 1 ? L["Household_InviteUsesOne"].Value : string.Format(L["Household_InviteUsesMany"].Value, option))</option>
                    }
                </select>
            </div>
            <div class="dialed-form-actions">
                <button id="household-invite" type="button" class="dialed-button" disabled="@busy" @onclick="InviteAsync">@L["Household_CreateInvite"]</button>
                @if (invite is not null && canShare)
                {
                    <button id="household-invite-share" type="button" class="dialed-button dialed-button-primary" @onclick="() => ShareAsync(invite.Code)">@L["Household_ShareInvite"]</button>
                }
            </div>
            @if (invite is not null)
            {
                <p id="household-invite-code">@(invite.MaxUses > 1
                    ? string.Format(L["Household_InviteCodeMany"].Value, invite.Code, invite.ExpiresAt.ToLocalTime().ToString("d", System.Globalization.CultureInfo.CurrentCulture), invite.MaxUses)
                    : L["Household_InviteCode", invite.Code, invite.ExpiresAt.ToLocalTime().ToString("d", System.Globalization.CultureInfo.CurrentCulture)])</p>
            }

            @if (openInvites.Count > 0)
            {
                <h4 id="household-open-invites-title">@L["Household_OpenInvites"]</h4>
                <ul id="household-open-invites" class="dialed-list">
                    @foreach (var open in openInvites)
                    {
                        <li class="household-open-invite" data-code="@open.Code">
                            <span class="household-invite-info">
                                <strong class="dialed-code">@open.Code</strong>
                                <span class="dialed-muted">@string.Format(L["Household_InviteProgress"].Value, open.Uses, open.MaxUses) · @string.Format(L["Household_InviteExpires"].Value, open.ExpiresAt.ToLocalTime().ToString("d MMM", System.Globalization.CultureInfo.CurrentCulture))</span>
                            </span>
                            <button type="button" class="dialed-button household-invite-revoke" disabled="@busy" aria-label="@string.Format(L["Household_RevokeNamed"].Value, open.Code)" @onclick="() => RevokeAsync(open.Code)">@L["Household_Revoke"]</button>
                        </li>
                    }
                </ul>
            }
        }

        @if (household.Members.Count == 1)
        {
            <form class="dialed-form" id="household-join-form" @onsubmit="JoinAsync" @onsubmit:preventDefault>
                <div class="dialed-field">
                    <label for="household-code-input">@L["Household_HaveCode"]</label>
                    <input id="household-code-input" type="text" maxlength="20" autocomplete="off" autocapitalize="characters" @bind="code" @bind:event="oninput" />
                </div>
                <div class="dialed-form-actions">
                    <button id="household-join" type="submit" class="dialed-button" disabled="@busy">@L["Household_Join"]</button>
                </div>
            </form>
        }
        else if (!household.YouAreOwner)
        {
            <div class="dialed-form-actions">
                @if (confirmingLeave)
                {
                    <button id="household-leave-confirm" type="button" class="dialed-button" disabled="@busy" @onclick="LeaveAsync">@L["Household_ConfirmLeave"]</button>
                }
                else
                {
                    <button id="household-leave" type="button" class="dialed-button" @onclick="() => confirmingLeave = true">@L["Household_Leave"]</button>
                }
            </div>
        }

        <div id="household-manage" class="household-manage">
            @if (creating)
            {
                <form class="dialed-form" id="household-create-form" @onsubmit="CreateAsync" @onsubmit:preventDefault>
                    <div class="dialed-field">
                        <label for="household-create-name">@L["Household_Name"]</label>
                        <input id="household-create-name" type="text" maxlength="@MaxNameLength" autocomplete="off" aria-describedby="household-create-hint" @bind="newName" @bind:event="oninput" />
                        <p id="household-create-hint" class="dialed-muted">@L["Household_CreateHint"]</p>
                    </div>
                    <div class="dialed-form-actions">
                        <button id="household-create-save" type="submit" class="dialed-button dialed-button-primary" disabled="@(busy || string.IsNullOrWhiteSpace(newName))">@L["Household_Create"]</button>
                        <button id="household-create-cancel" type="button" class="dialed-button" @onclick="() => creating = false">@L["Cancel"]</button>
                    </div>
                </form>
            }
            else if (confirmingDelete)
            {
                <div id="household-delete-confirmation" class="household-delete-confirmation" role="group" aria-labelledby="household-delete-warning">
                    <p id="household-delete-warning">@string.Format(L["Household_DeleteWarning"].Value, household.Name)</p>
                    <div class="dialed-form-actions">
                        <button id="household-delete-confirm" type="button" class="dialed-button dialed-button-danger" disabled="@busy" @onclick="DeleteAsync">@L["Household_ConfirmDelete"]</button>
                        <button id="household-delete-cancel" type="button" class="dialed-button" @onclick="() => confirmingDelete = false">@L["Cancel"]</button>
                    </div>
                </div>
            }
            else
            {
                <div class="dialed-form-actions">
                    <button id="household-create" type="button" class="dialed-button" @onclick="StartCreate">@L["Household_New"]</button>
                    @if (household.YouAreOwner && householdCount > 1)
                    {
                        @* The last household a person has cannot be deleted, the same rule as leaving. *@
                        <button id="household-delete" type="button" class="dialed-button" @onclick="() => { confirmingDelete = true; renaming = false; message = null; }">@L["Household_Delete"]</button>
                    }
                </div>
            }
        </div>
    }

    @if (message is not null)
    {
        <p id="household-message" role="status">@message</p>
    }
</div>

@code {
    private HouseholdInfo? household;
    private InviteInfo? invite;
    private IReadOnlyList<InviteInfo> openInvites = [];
    private int maxUses = 1;
    private bool canShare;
    private static readonly int[] UseOptions = [1, 2, 3, 5, 10];
    private string code = "";
    private string? message;
    private string? removing;
    private string? transferring;
    private bool confirmingLeave;
    private bool renaming;
    private bool creating;
    private bool confirmingDelete;
    private string newName = "";
    private int householdCount;
    private const int MaxNameLength = 60;
    private bool busy;
    private bool failed;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        Households.Changed += OnHouseholdsChanged;
        canShare = await Share.IsSupportedAsync();
        if (Session.IsSignedIn)
        {
            await LoadAsync();
        }
    }

    // The household was switched or changed from elsewhere (the header picker): show the new one.
    private void OnHouseholdsChanged() => _ = InvokeAsync(async () =>
    {
        if (Session.IsSignedIn && !busy)
        {
            invite = null;
            await LoadAsync();
            StateHasChanged();
        }
    });

    private void OnSessionChanged()
    {
        if (!Session.IsSignedIn)
        {
            household = null;
            invite = null;
        }

        _ = InvokeAsync(async () =>
        {
            if (Session.IsSignedIn && household is null && !busy)
            {
                await LoadAsync();
            }

            StateHasChanged();
        });
    }

    private async Task LoadAsync()
    {
        failed = false;
        try
        {
            household = await Households.GetAsync();
            await LoadInvitesAsync();
            await LoadCountAsync();
        }
        catch (Exception exception) when (exception is AccountApiException or AccountRefusedException)
        {
            failed = true;
        }
    }

    /// <summary>The owner's open invites; others have none to see, and a failure here only hides the list.</summary>
    private async Task LoadInvitesAsync()
    {
        openInvites = [];
        if (household?.YouAreOwner != true)
        {
            return;
        }

        try
        {
            openInvites = await Households.ListInvitesAsync();
        }
        catch (Exception exception) when (exception is AccountApiException or AccountRefusedException)
        {
            // Not fatal: the household itself is shown.
        }
    }

    /// <summary>How many households the person is in: the last one cannot be deleted. Unknown (offline) hides the delete button.</summary>
    private async Task LoadCountAsync()
    {
        try
        {
            householdCount = (await Households.ListAsync()).Count;
        }
        catch (Exception exception) when (exception is AccountApiException or AccountRefusedException)
        {
            householdCount = 0;
        }
    }

    private void StartRename()
    {
        newName = household?.Name ?? "";
        renaming = true;
        creating = false;
        confirmingDelete = false;
        message = null;
    }

    private void StartCreate()
    {
        newName = "";
        creating = true;
        renaming = false;
        confirmingDelete = false;
        message = null;
    }

    private Task RenameAsync() => RunAsync(async () =>
    {
        household = await Households.RenameAsync(newName.Trim());
        renaming = false;
        message = L["Household_Renamed"];
    });

    private Task CreateAsync() => RunAsync(async () =>
    {
        household = await Households.CreateAsync(newName.Trim());
        creating = false;
        invite = null;
        await LoadInvitesAsync();
        await LoadCountAsync();
        message = string.Format(L["Household_Created"].Value, household.Name);
    });

    private Task DeleteAsync() => RunAsync(async () =>
    {
        household = await Households.DeleteAsync();
        confirmingDelete = false;
        invite = null;
        await LoadInvitesAsync();
        await LoadCountAsync();
        message = string.Format(L["Household_Deleted"].Value, household.Name);
    });

    private Task InviteAsync() => RunAsync(async () =>
    {
        invite = await Households.CreateInviteAsync(maxUses);
        await LoadInvitesAsync();
    });

    private Task RevokeAsync(string inviteCode) => RunAsync(async () =>
    {
        await Households.RevokeInviteAsync(inviteCode);
        if (invite?.Code == inviteCode)
        {
            invite = null;
        }

        await LoadInvitesAsync();
        message = string.Format(L["Household_InviteRevoked"].Value, inviteCode);
    });

    private async Task ShareAsync(string inviteCode) =>
        await Share.ShareAsync(new Dialed.Client.Platform.ShareRequest(L["Household_ShareTitle"].Value, string.Format(L["Household_ShareText"].Value, inviteCode), Navigation.BaseUri));

    private Task JoinAsync() => RunAsync(async () =>
    {
        household = await Households.JoinAsync(code.Trim());
        code = "";
        invite = null;
        await LoadInvitesAsync();
    });

    private Task LeaveAsync() => RunAsync(async () =>
    {
        household = await Households.LeaveAsync();
        confirmingLeave = false;
        await LoadCountAsync();
    });

    private Task RemoveAsync(string userId) => RunAsync(async () =>
    {
        household = await Households.RemoveMemberAsync(userId);
        removing = null;
    });

    private Task TransferAsync(string userId) => RunAsync(async () =>
    {
        household = await Households.TransferOwnershipAsync(userId);
        transferring = null;
    });

    private async Task RunAsync(Func<Task> action)
    {
        busy = true;
        message = null;
        try
        {
            await action();
        }
        catch (AccountRefusedException exception)
        {
            message = exception.Message;
        }
        catch (AccountApiException exception)
        {
            // Moving to another household (creating one) first sends what is waiting; say so when that did not work.
            message = exception.Message.StartsWith("Some changes", StringComparison.Ordinal) ? L["Household_SwitchPending"] : L["Account_Unavailable"];
        }
        finally
        {
            busy = false;
        }
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Households.Changed -= OnHouseholdsChanged;
    }
}
