@* One number with a label, for summaries: "18 g", "Remaining"; the optional hint sits below. *@
<div class="dialed-stat-tile" @attributes="AdditionalAttributes">
    <span class="dialed-stat-value">@Value</span>
    <span class="dialed-stat-label">@Label</span>
    @if (Hint is not null)
    {
        <span class="dialed-stat-hint">@Hint</span>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Value { get; set; } = "";

    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter]
    public string? Hint { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
