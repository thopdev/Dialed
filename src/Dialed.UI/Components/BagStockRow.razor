@using Dialed.Client.Preferences
@using Dialed.Domain.Inventory
@inject IStringLocalizer<Strings> L
@inject UnitFormatter Units

@* A bag with what is left, how many cups that is and how fresh it is. *@
<ListRow Title="@Name" Subtitle="@Subtitle" Href="@($"brew/{Stock.Bag.Id}")" data-bag="@Stock.Bag.Id">
    <Leading><RoastThumb PhotoId="@PhotoId" Level="@RoastLevel" /></Leading>
    <Below>
        <Meter Label="@string.Format(L["Stock_LeftIn"].Value, Name)" Fraction="@Fraction" Tone="@(Stock.IsLow ? Meter.MeterTone.Warning : Meter.MeterTone.Normal)"
               ValueText="@string.Format(L["Stock_LeftOf"].Value, Units.Weight(Stock.RemainingG), Units.Weight(Stock.Bag.WeightG))" />
    </Below>
    <Trailing>
        @if (Stock.IsLow)
        {
            <Chip Selected="true">@L["Stock_Low"]</Chip>
        }
        @if (Stock.Freshness != Freshness.Unknown)
        {
            <Chip>@L[$"Fresh_{Stock.Freshness}"]</Chip>
        }
    </Trailing>
</ListRow>

@code {
    [Parameter, EditorRequired]
    public BagStock Stock { get; set; } = null!;

    /// <summary>The bean's first photo, if any.</summary>
    [Parameter]
    public string? PhotoId { get; set; }

    /// <summary>Tints the placeholder when there is no photo.</summary>
    [Parameter]
    public Dialed.Domain.Model.RoastLevel? RoastLevel { get; set; }

    private string Name => Stock.BeanName.Length > 0 ? Stock.BeanName : L["Bag_UnknownBean"].Value;

    private double Fraction => Stock.Bag.WeightG > 0 ? (double)(Stock.RemainingG / Stock.Bag.WeightG) : 0;

    private string Subtitle
    {
        get
        {
            var parts = new List<string> { string.Format(L["Brew_Left"].Value, Units.Weight(Stock.RemainingG)) };
            if (Stock.Cups is { } cups)
            {
                parts.Add(string.Format(L["Stock_Cups"].Value, cups));
            }

            if (Stock.AgeDays is { } age)
            {
                parts.Add(string.Format(L["Stock_DaysSinceRoast"].Value, age));
            }

            return string.Join(" · ", parts);
        }
    }
}
