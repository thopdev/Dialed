@* Shows whether the app can reach the API - handy when checking the dev tunnel on an iPhone. *@
@inject HttpClient Http
@inject IStringLocalizer<Strings> L

<p class="api-status">@L["Api_Status", status ?? L["Api_Checking"].Value]</p>

@code {
    private string? status;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            status = await Http.GetStringAsync("health");
        }
        catch (Exception exception) when (exception is HttpRequestException or TaskCanceledException)
        {
            status = L["Api_Unreachable"];
        }
    }
}
