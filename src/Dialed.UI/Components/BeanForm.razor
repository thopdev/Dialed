@using Dialed.Domain.Model
@inject IStringLocalizer<Strings> L
@inject Dialed.Client.Preferences.IUserPreferences Preferences
@inject Dialed.Client.Data.IRepository<Vendor> VendorStore

@* Create/edit form for a bean. Offline-first: the parent saves the result. *@
<form class="dialed-form dialed-sectioned-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault novalidate>
    <section class="dialed-form-section" aria-labelledby="bean-section-bean">
    <h2 id="bean-section-bean" class="dialed-form-section-title">@L["BeanForm_SectionBean"]</h2>
    <div class="dialed-field">
        <label for="bean-name">@L["Bean_Name"]</label>
        <input id="bean-name" type="text" @bind="name" @bind:event="oninput" @onblur="ValidateName" autocomplete="off" autocapitalize="words" enterkeyhint="next"
               aria-required="true" aria-invalid="@(nameError is not null ? "true" : null)" aria-describedby="@(nameError is not null ? "bean-name-error" : null)" />
        @if (nameError is not null)
        {
            <div id="bean-name-error" class="dialed-field-error" role="alert">@nameError</div>
        }
    </div>

    <VendorPicker Label="@L["Bean_Roaster"]" @bind-SelectedId="roasterId" Kind="VendorKinds.Roaster" UseCatalog="@(Bean is null)" />

    @if (Bean is null)
    {
        <CatalogSuggestions Query="@name" OnUse="UseCatalogAsync" />
    }
    </section>

    <section class="dialed-form-section" aria-labelledby="bean-section-origin">
    <h2 id="bean-section-origin" class="dialed-form-section-title">@L["BeanForm_SectionOrigin"]</h2>
    <div class="dialed-field-row">
        <div class="dialed-field">
            <label for="bean-country">@L["Bean_Country"]</label>
            <input id="bean-country" type="text" @bind="country" autocomplete="off" autocapitalize="words" />
        </div>
        <div class="dialed-field">
            <label for="bean-region">@L["Bean_Region"]</label>
            <input id="bean-region" type="text" @bind="region" autocomplete="off" autocapitalize="words" />
        </div>
    </div>
    <div class="dialed-field-row">
        <div class="dialed-field">
            <label for="bean-farm">@L["Bean_Farm"]</label>
            <input id="bean-farm" type="text" @bind="farm" autocomplete="off" autocapitalize="words" />
        </div>
        <div class="dialed-field">
            <label for="bean-producer">@L["Bean_Producer"]</label>
            <input id="bean-producer" type="text" @bind="producer" autocomplete="off" autocapitalize="words" />
        </div>
    </div>

    <ChipInput Label="@L["Bean_Varieties"]" @bind-Values="varieties" />

    <div id="bean-barcodes">
        <ChipInput Label="@L["Bean_Barcodes"]" @bind-Values="barcodes" />
        <p class="dialed-muted">@L["Bean_BarcodesHint"]</p>
        @if (barcodeError is not null)
        {
            <div id="bean-barcodes-error" class="dialed-field-error" role="alert">@barcodeError</div>
        }
    </div>

    <div class="dialed-field">
        <label for="bean-altitude">@L["Bean_Altitude"]</label>
        <input id="bean-altitude" type="number" inputmode="numeric" min="0" max="5000" step="1" @bind="altitude" @bind:event="onchange" @onblur="ValidateAltitude"
               aria-invalid="@(altitudeError is not null ? "true" : null)" aria-describedby="@(altitudeError is not null ? "bean-altitude-error" : null)" />
        @if (altitudeError is not null)
        {
            <div id="bean-altitude-error" class="dialed-field-error" role="alert">@altitudeError</div>
        }
    </div>
    </section>

    <section class="dialed-form-section" aria-labelledby="bean-section-roast">
    <h2 id="bean-section-roast" class="dialed-form-section-title">@L["BeanForm_SectionRoast"]</h2>

    <div class="dialed-field">
        <label for="bean-process">@L["Bean_Process"]</label>
        <select id="bean-process" value="@processChoice" @onchange="OnProcessChanged">
            <option value="">@L["Bean_None"]</option>
            @foreach (var known in BeanQuery.KnownProcesses)
            {
                <option value="@known">@known</option>
            }
            <option value="@OtherValue">@L["Bean_Other"]</option>
        </select>
        @if (processChoice == OtherValue)
        {
            <label for="bean-process-other">@L["Bean_ProcessOther"]</label>
            <input id="bean-process-other" type="text" @bind="processOther" autocomplete="off" />
        }
    </div>

    <div class="dialed-field-row">
    <div class="dialed-field">
        <label for="bean-roast-level">@L["Bean_RoastLevel"]</label>
        <select id="bean-roast-level" @bind="roastLevel">
            <option value="">@L["Bean_None"]</option>
            @foreach (var level in Enum.GetValues<RoastLevel>())
            {
                <option value="@level">@L[$"RoastLevel_{level}"]</option>
            }
        </select>
    </div>

    <div class="dialed-field">
        <label for="bean-roast-style">@L["Bean_RoastStyle"]</label>
        <select id="bean-roast-style" @bind="roastStyle">
            <option value="">@L["Bean_None"]</option>
            @foreach (var style in Enum.GetValues<RoastStyle>())
            {
                <option value="@style">@L[$"RoastStyle_{style}"]</option>
            }
        </select>
    </div>

    </div>

    <label class="dialed-check"><input id="bean-decaf" type="checkbox" @bind="isDecaf" /> @L["Bean_Decaf"]</label>
    </section>

    <section class="dialed-form-section" aria-labelledby="bean-section-tasting">
    <h2 id="bean-section-tasting" class="dialed-form-section-title">@L["BeanForm_SectionTasting"]</h2>
    <ChipInput Label="@L["Bean_TastingNotes"]" @bind-Values="tastingNotes" />

    <div class="dialed-field">
        <label>@L["Bean_Rating"]</label>
        <StarRating @bind-Value="rating" />
    </div>

    <div class="dialed-field">
        <label>@L["Photo_Title"]</label>
        <PhotoStrip PhotoIds="@photoIds" PhotoIdsChanged="@(v => photoIds = v)" Label="@L["Photo_Title"].Value" />
    </div>

    <div class="dialed-field">
        <label for="bean-notes">@L["Bean_Notes"]</label>
        <textarea id="bean-notes" rows="3" @bind="notes"></textarea>
    </div>

    </section>

    <section class="dialed-form-section" aria-labelledby="bean-section-sharing">
    <h2 id="bean-section-sharing" class="dialed-form-section-title">@L["BeanForm_SectionSharing"]</h2>
    <div class="dialed-field">
        <label for="bean-visibility">@L["Bean_Visibility"]</label>
        <select id="bean-visibility" @bind="visibility" aria-describedby="@(visibility == Visibility.Public ? "bean-visibility-hint" : null)">
            @foreach (var option in Enum.GetValues<Visibility>())
            {
                <option value="@option">@L[$"Visibility_{option}"]</option>
            }
        </select>
    </div>
    @if (visibility == Visibility.Public)
    {
        <p id="bean-visibility-hint" class="dialed-muted" role="note">@L["Visibility_PublicHint"]</p>
    }

    </section>

    <div class="dialed-form-actions dialed-sticky-actions">
        <button type="submit" class="dialed-button dialed-button-primary">@L["Save"]</button>
        <button type="button" class="dialed-button" @onclick="OnCancel">@L["Cancel"]</button>
    </div>
</form>

@code {
    private const string OtherValue = "__other";

    private string name = "";
    private string? roasterId;
    private string? country;
    private string? region;
    private string? farm;
    private string? producer;
    private IReadOnlyList<string> varieties = [];
    private IReadOnlyList<string> barcodes = [];
    private string? barcodeError;
    private string processChoice = "";
    private string? processOther;
    private int? altitude;
    private RoastLevel? roastLevel;
    private RoastStyle? roastStyle;
    private bool isDecaf;
    private IReadOnlyList<string> tastingNotes = [];
    private int rating;
    private string? notes;
    private Visibility visibility = Visibility.Household;
    private IReadOnlyList<string> photoIds = [];
    private string? nameError;
    private string? altitudeError;
    private Bean? loaded;

    /// <summary>The bean being edited; <c>null</c> for a new one.</summary>
    [Parameter]
    public Bean? Bean { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<Bean> OnSubmit { get; set; }

    [Parameter]
    public EventCallback OnCancel { get; set; }

    protected override void OnInitialized() => visibility = Preferences.Profile.DefaultVisibility;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(Bean, loaded))
        {
            return;
        }

        loaded = Bean;
        name = Bean?.Name ?? "";
        roasterId = Bean?.RoasterId;
        country = Bean?.Origin.Country;
        region = Bean?.Origin.Region;
        farm = Bean?.Origin.Farm;
        producer = Bean?.Origin.Producer;
        varieties = Bean?.Varieties ?? [];
        barcodes = Bean?.Barcodes ?? [];
        var process = Bean?.Process;
        if (string.IsNullOrEmpty(process))
        {
            processChoice = "";
        }
        else if (BeanQuery.IsKnownProcess(process))
        {
            processChoice = BeanQuery.KnownProcesses.First(p => string.Equals(p, process, StringComparison.OrdinalIgnoreCase));
        }
        else
        {
            processChoice = OtherValue;
            processOther = process;
        }

        altitude = Bean?.AltitudeM;
        roastLevel = Bean?.RoastLevel;
        roastStyle = Bean?.RoastStyle;
        isDecaf = Bean?.IsDecaf ?? false;
        tastingNotes = Bean?.TastingNotes ?? [];
        rating = Bean?.Rating ?? 0;
        notes = Bean?.Notes;
        visibility = Bean?.Visibility ?? Preferences.Profile.DefaultVisibility;
        photoIds = Bean?.PhotoIds ?? [];
    }

    /// <summary>
    /// Copies a catalog entry into the form (#105): its fields fill what the entry knows, the roaster is the one I already have or a new
    /// one made from its name. Nothing is linked and every field stays editable.
    /// </summary>
    private async Task UseCatalogAsync(Dialed.Client.Catalog.CatalogBean entry)
    {
        name = entry.Name;
        country = entry.Country ?? country;
        region = entry.Region ?? region;
        if (!string.IsNullOrWhiteSpace(entry.Process))
        {
            if (BeanQuery.IsKnownProcess(entry.Process))
            {
                processChoice = BeanQuery.KnownProcesses.First(p => string.Equals(p, entry.Process, StringComparison.OrdinalIgnoreCase));
            }
            else
            {
                processChoice = OtherValue;
                processOther = entry.Process;
            }
        }

        if (entry.Varieties.Count > 0)
        {
            varieties = entry.Varieties;
        }

        roastLevel = entry.RoastLevel ?? roastLevel;
        if (entry.TastingNotes.Count > 0)
        {
            tastingNotes = entry.TastingNotes;
        }

        if (!string.IsNullOrWhiteSpace(entry.RoasterName))
        {
            var known = Dialed.Domain.Text.LabelMatcher.Find(entry.RoasterName, null, null, await VendorStore.ListAsync(), []).BestRoaster?.Item;
            roasterId = (known ?? await VendorStore.SaveAsync(new Vendor { Name = entry.RoasterName.Trim(), Kinds = VendorKinds.Roaster })).Id;
        }
    }

    private void OnProcessChanged(ChangeEventArgs e) => processChoice = e.Value?.ToString() ?? "";

    private static string? Clean(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private void ValidateName() => nameError = string.IsNullOrWhiteSpace(name) ? L["Bean_NameRequired"].Value : null;

    private void ValidateAltitude() => altitudeError = altitude is < 0 or > 5000 ? L["Bean_AltitudeRange"].Value : null;

    /// <summary>A code that looks like a retail barcode must have the right check digit, so a mistyped one is caught here.</summary>
    private void ValidateBarcodes()
    {
        var bad = barcodes.FirstOrDefault(code => Dialed.Domain.Barcodes.BarcodeMatcher.Normalize(code) is null);
        barcodeError = bad is null ? null : string.Format(L["Bean_BarcodeInvalid"].Value, bad);
    }

    private async Task SubmitAsync()
    {
        ValidateName();
        ValidateAltitude();
        ValidateBarcodes();
        if (nameError is not null || altitudeError is not null || barcodeError is not null)
        {
            return;
        }

        var process = processChoice switch
        {
            "" => null,
            OtherValue => Clean(processOther),
            _ => processChoice,
        };

        var bean = (Bean ?? new Bean { Name = name }) with
        {
            Name = name.Trim(),
            RoasterId = roasterId,
            Origin = new BeanOrigin(Clean(country), Clean(region), Clean(farm), Clean(producer)),
            Varieties = varieties,
            Barcodes = Dialed.Domain.Barcodes.BarcodeMatcher.NormalizeAll(barcodes),
            Process = process,
            AltitudeM = altitude is > 0 ? altitude : null,
            RoastLevel = roastLevel,
            RoastStyle = roastStyle,
            IsDecaf = isDecaf,
            TastingNotes = tastingNotes,
            Rating = rating > 0 ? rating : null,
            Notes = Clean(notes),
            Visibility = visibility,
            PhotoIds = photoIds,
        };
        await OnSubmit.InvokeAsync(bean);
    }
}
