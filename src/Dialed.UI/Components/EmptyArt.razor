@* A small animated drawing for an empty screen. Decorative; the motion is CSS and stops for people who ask for reduced motion. *@
<svg class="dialed-art dialed-art-@Kind.ToString().ToLowerInvariant()" viewBox="0 0 120 120" width="112" height="112" aria-hidden="true" focusable="false">
    <ellipse class="dialed-art-shadow" cx="60" cy="110" rx="38" ry="5" />
    @switch (Kind)
    {
        case EmptyArtKind.Bag:
            <path class="dialed-art-body" d="M34 34h52l6 70H28z" />
            <path class="dialed-art-flap" d="M34 34l6-14h40l6 14" />
            <g class="dialed-art-bean"><ellipse cx="60" cy="72" rx="11" ry="15" transform="rotate(35 60 72)" /><path d="M54 64c5 5 2 10 7 14" /></g>
            break;
        case EmptyArtKind.Recipe:
            <rect class="dialed-art-body" x="26" y="20" width="68" height="86" rx="10" />
            <path class="dialed-art-write dialed-art-line1" d="M40 44h40" />
            <path class="dialed-art-write dialed-art-line2" d="M40 60h40" />
            <path class="dialed-art-write dialed-art-line3" d="M40 76h24" />
            break;
        case EmptyArtKind.People:
            <g class="dialed-art-cup-left"><path class="dialed-art-body" d="M14 62h36v14a14 14 0 0 1-14 14h-8a14 14 0 0 1-14-14z" /><path class="dialed-art-line" d="M50 66h4a7 7 0 0 1 0 14h-4" /></g>
            <g class="dialed-art-cup-right"><path class="dialed-art-body" d="M70 62h36v14a14 14 0 0 1-14 14h-8a14 14 0 0 1-14-14z" /><path class="dialed-art-line" d="M70 66h-4a7 7 0 0 0 0 14h4" /></g>
            <path class="dialed-art-steam" d="M32 52q4-6 0-12M88 52q4-6 0-12" />
            break;
        case EmptyArtKind.Search:
            <g class="dialed-art-lens"><circle class="dialed-art-body" cx="52" cy="52" r="26" /><path class="dialed-art-line" d="M72 72l22 22" /><ellipse class="dialed-art-bean-fill" cx="52" cy="52" rx="9" ry="12" transform="rotate(35 52 52)" /></g>
            break;
        case EmptyArtKind.Cloud:
            <g class="dialed-art-float"><path class="dialed-art-body" d="M34 84a18 18 0 0 1 2-36 24 24 0 0 1 46 6 15 15 0 0 1 2 30z" /><path class="dialed-art-line" d="M50 70l20-20M70 70L50 50" /></g>
            break;
        case EmptyArtKind.Kettle:
            <path class="dialed-art-body" d="M32 56h44v30a14 14 0 0 1-14 14H46a14 14 0 0 1-14-14z" />
            <path class="dialed-art-line" d="M76 62l16-10v12M32 66h-8a8 8 0 0 0 0 16h8M46 56a14 10 0 0 1 28 0" />
            <path class="dialed-art-steam" d="M96 44q5-7 0-14M86 40q5-7 0-14" />
            break;
        case EmptyArtKind.Chart:
            <rect class="dialed-art-body dialed-art-bar1" x="28" y="64" width="16" height="40" rx="4" />
            <rect class="dialed-art-body dialed-art-bar2" x="52" y="44" width="16" height="60" rx="4" />
            <rect class="dialed-art-body dialed-art-bar3" x="76" y="24" width="16" height="80" rx="4" />
            break;
        default:
            <path class="dialed-art-body" d="M26 52h58v22a24 24 0 0 1-24 24h-10a24 24 0 0 1-24-24z" />
            <path class="dialed-art-line" d="M84 58h6a11 11 0 0 1 0 22h-8" />
            <path class="dialed-art-saucer" d="M26 106h58" />
            <path class="dialed-art-steam" d="M44 40q6-8 0-16M60 40q6-8 0-16M76 40q6-8 0-16" />
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public EmptyArtKind Kind { get; set; }

    /// <summary>The drawing that fits one of the icons the empty screens already pass, or null when none fits.</summary>
    public static EmptyArtKind? For(string? iconName) => iconName switch
    {
        "Box" => EmptyArtKind.Bag,
        "DrinkCoffee" or "History" => EmptyArtKind.Cup,
        "BookOpen" => EmptyArtKind.Recipe,
        "People" or "PersonClock" => EmptyArtKind.People,
        "Search" => EmptyArtKind.Search,
        "CloudOff" => EmptyArtKind.Cloud,
        _ => null,
    };
}
