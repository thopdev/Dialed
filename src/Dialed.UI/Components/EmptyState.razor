@* Friendly "nothing here yet": optional icon, title, message and a call-to-action (ChildContent). *@
<div class="dialed-empty">
    @if (Icon is not null)
    {
        <span class="dialed-empty-icon" aria-hidden="true">
            <FluentIcon Value="@Icon" Color="Color.Custom" CustomColor="currentColor" Width="48px" />
        </span>
    }
    @if (Title is not null)
    {
        <h2 class="dialed-empty-title">@Title</h2>
    }
    <p>@Message</p>
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired]
    public string Message { get; set; } = "";

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public Icon? Icon { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
