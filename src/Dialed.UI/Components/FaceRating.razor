@inject IStringLocalizer<Strings> L

@*
    A 1 to 5 rating as five drawn faces, from unhappy to delighted. Editable: a radio group of big buttons (arrow keys and VoiceOver work),
    each named with its word ("Poor" ... "Perfect"). Tapping the chosen face again clears the rating. Value 0 = not rated.
*@
<span class="dialed-faces" role="radiogroup" aria-label="@L["Rating_Label"]">
    @for (var face = 1; face <= 5; face++)
    {
        var current = face;
        var (edge, control) = Mouth(current);
        <button type="button"
                class="dialed-face @(current == Value ? "on" : "")"
                role="radio"
                aria-checked="@(current == Value ? "true" : "false")"
                aria-label="@L[$"QuickLog_Rating{current}"]"
                @onclick="() => Select(current)">
            <svg viewBox="0 0 40 40" width="100%" height="100%" aria-hidden="true" focusable="false">
                <circle cx="20" cy="20" r="18" class="dialed-face-disc" />
                <circle cx="14" cy="16" r="2" class="dialed-face-feature" />
                <circle cx="26" cy="16" r="2" class="dialed-face-feature" />
                <path d="M11 @edge Q20 @control 29 @edge" class="dialed-face-mouth" />
            </svg>
        </button>
    }
</span>

@code {
    [Parameter]
    public int Value { get; set; }

    [Parameter]
    public EventCallback<int> ValueChanged { get; set; }

    private static (int Edge, int Control) Mouth(int face) => face switch
    {
        1 => (28, 20),
        2 => (27, 23),
        3 => (26, 26),
        4 => (24, 30),
        _ => (23, 34),
    };

    private Task Select(int face) => ValueChanged.InvokeAsync(face == Value ? 0 : face);
}
