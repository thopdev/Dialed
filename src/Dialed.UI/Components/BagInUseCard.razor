@using Dialed.Client.Preferences
@using Dialed.Domain.Inventory
@inject IStringLocalizer<Strings> L
@inject UnitFormatter Units

@* An open bag on Home: photo, bean, freshness, and how much is left as a bar. Tapping it starts a brew from this bag. *@
<a class="dialed-card dialed-card-link dialed-bag-card" href="@($"brew/{Stock.Bag.Id}")" data-bag="@Stock.Bag.Id">
    <span class="dialed-bag-card-top">
        <Thumb PhotoId="@PhotoId" Size="56" />
        <span class="dialed-bag-card-text">
            <span class="dialed-bag-card-title">@Name</span>
            <span class="dialed-bag-card-subtitle">@Subtitle</span>
        </span>
        <StockRing Label="@string.Format(L["Home_RemainingOf"].Value, Name)" Fraction="@Fraction" Tone="@Tone" ValueText="@LeftOf" Text="@Units.Weight(Stock.RemainingG)" />
        <span class="dialed-bag-card-chips">
            @if (Stock.IsLow)
            {
                <Chip Selected="true">@L["Stock_Low"]</Chip>
            }
            @if (Stock.Freshness != Freshness.Unknown)
            {
                <Chip>@L[$"Fresh_{Stock.Freshness}"]</Chip>
            }
        </span>
    </span>
</a>

@code {
    [Parameter, EditorRequired]
    public BagStock Stock { get; set; } = null!;

    /// <summary>The bean's first photo, if any.</summary>
    [Parameter]
    public string? PhotoId { get; set; }

    private string Name => Stock.BeanName.Length > 0 ? Stock.BeanName : L["Bag_UnknownBean"].Value;

    private string Subtitle
    {
        get
        {
            var age = Stock.AgeDays is { } days ? string.Format(L["Stock_DaysSinceRoast"].Value, days) : L["Fresh_Unknown"].Value;
            return Stock.Cups is { } cups ? $"{age} · {string.Format(L["Stock_Cups"].Value, cups)}" : age;
        }
    }

    private double Fraction => Stock.Bag.WeightG > 0 ? (double)(Stock.RemainingG / Stock.Bag.WeightG) : 0;

    private Meter.MeterTone Tone => Stock.IsLow ? Meter.MeterTone.Warning : Meter.MeterTone.Normal;

    private string LeftOf => string.Format(L["Home_LeftOf"].Value, Units.Weight(Stock.RemainingG), Units.Weight(Stock.Bag.WeightG));
}
