@inject Dialed.Client.PhotoService Photos

@* A square thumbnail: the item's first photo when there is one, otherwise a calm placeholder (a coffee bean, or the icon you give). Decorative unless Alt is given. *@
<span class="dialed-thumb" style="--dialed-thumb-size: @(Size)px" @attributes="AdditionalAttributes">
    @if (uri is not null)
    {
        <img src="@uri" alt="@(Alt ?? "")" loading="lazy" />
    }
    else
    {
        <span class="dialed-thumb-placeholder" aria-hidden="true">
            @if (Placeholder is not null)
            {
                <FluentIcon Value="@Placeholder" Color="Color.Custom" CustomColor="currentColor" />
            }
            else
            {
                <BeanIcon Size="@(Math.Max(20, Size / 2))" />
            }
        </span>
    }
</span>

@code {
    private string? uri;
    private string? loadedFor;

    /// <summary>The photo to show, or <c>null</c> for the placeholder.</summary>
    [Parameter]
    public string? PhotoId { get; set; }

    [Parameter]
    public Icon? Placeholder { get; set; }

    [Parameter]
    public int Size { get; set; } = 56;

    [Parameter]
    public string? Alt { get; set; }

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (PhotoId == loadedFor)
        {
            return;
        }

        loadedFor = PhotoId;
        uri = PhotoId is null ? null : await Photos.GetImageSourceAsync(PhotoId);
    }
}
