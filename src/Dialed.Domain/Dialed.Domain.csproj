<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared domain model and rules. No references to other Dialed projects or to ASP.NET Core. -->

  <ItemGroup>
    <!-- Versioned reference data, bundled in the assembly so the app works offline. -->
    <EmbeddedResource Include="BrewMethods\brew-methods.json" LogicalName="Dialed.Domain.brew-methods.json" />
    <EmbeddedResource Include="BrewMethods\default-recipes.json" LogicalName="Dialed.Domain.default-recipes.json" />
    <EmbeddedResource Include="BrewMethods\pour-routines.json" LogicalName="Dialed.Domain.pour-routines.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Dialed.Domain.Tests" />
  </ItemGroup>

</Project>
