{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Protection": {
    "RequestsPerMinute": 300,
    "AuthRequestsPerMinute": 20,
    "AiRequestsPerMinute": 10,
    "FriendsRequestsPerMinute": 30,
    "ReportsPerMinute": 5,
    "AdminRequestsPerMinute": 20,
    "MaxRequestBodyBytes": 1048576
  },
  "Beta": {
    "InviteRequired": true
  }
}
