<Project Sdk="Aspire.AppHost.Sdk/13.6.4">

  <!-- Local orchestration: Cosmos DB emulator, Azurite, API, Functions and the PWA with one F5 / `dotnet run`. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UserSecretsId>b98ed8ef-e770-4f31-8c80-f5b8c2a6e802</UserSecretsId>
    <!-- DCP and dashboard come from NuGet so F5 / `dotnet run` works without installing the Aspire CLI. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);ASPIRE010</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Azure.CosmosDB" />
    <PackageReference Include="Aspire.Hosting.Azure.Functions" />
    <PackageReference Include="Aspire.Hosting.Azure.Storage" />
    <PackageReference Include="Aspire.Hosting.DevTunnels" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dialed.Api\Dialed.Api.csproj" />
    <ProjectReference Include="..\Dialed.Functions\Dialed.Functions.csproj" />
    <ProjectReference Include="..\Dialed.Web\Dialed.Web.csproj" />
  </ItemGroup>

</Project>
