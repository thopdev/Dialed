{
  "$comment": "Azure Static Web Apps configuration for the PWA (#22).",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/_framework/*", "/_content/*", "/icons/*", "/js/*", "/css/*", "*.{css,js,json,webmanifest,png,jpg,svg,ico,wasm,dll,dat,blat,woff,woff2,map}"]
  },
  "routes": [
    { "route": "/service-worker.js", "headers": { "cache-control": "no-cache" } },
    { "route": "/service-worker-assets.js", "headers": { "cache-control": "no-cache" } },
    { "route": "/index.html", "headers": { "cache-control": "no-cache" } },
    { "route": "/manifest.webmanifest", "headers": { "cache-control": "no-cache" } },
    { "route": "/appsettings.json", "headers": { "cache-control": "no-cache" } },
    { "route": "/_framework/*", "headers": { "cache-control": "public, max-age=31536000, immutable" } },
    { "route": "/icons/*", "headers": { "cache-control": "public, max-age=604800" } }
  ],
  "mimeTypes": {
    ".webmanifest": "application/manifest+json",
    ".blat": "application/octet-stream",
    ".dat": "application/octet-stream"
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(self), microphone=(), geolocation=(), publickey-credentials-get=(self), publickey-credentials-create=(self)",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "Content-Security-Policy-Report-Only": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.blob.core.windows.net; font-src 'self' data:; connect-src 'self' https://*.azurecontainerapps.io https://*.blob.core.windows.net; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
  }
}
